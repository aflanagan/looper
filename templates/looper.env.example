# Looper env file — copy to ~/.config/looper/env (global) or ./.looper/env (per-project).
# Auto-sourced by `looper` so you don't need a long var prefix on every run.
# Anything already set in your shell overrides these. NEVER commit a real one
# (the repo .gitignore excludes .looper/env and looper.env).

# --- Which agent + model ---------------------------------------------------
# Agents: claude | codex | opencode. Only opencode uses the *_MODEL vars.
LOOPER_IMPLEMENTATION_AGENT=opencode
LOOPER_IMPLEMENTATION_MODEL=xai/grok-4.5
LOOPER_REVIEW_AGENT=opencode
LOOPER_REVIEW_MODEL=xai/grok-4.5

# --- Provider API keys (read by opencode for model auth) -------------------
# Alternatively run `opencode auth login` and omit these.
# XAI_API_KEY=xai-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Optional knobs --------------------------------------------------------
# LOOPER_REVIEW_MAX_ROUNDS=5
