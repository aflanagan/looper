# Copy to ~/.config/looper/env or ./.looper/env.
# Shell values already present in the environment take precedence.

# Agents: claude | codex | opencode. Model variables apply only to opencode.
LOOPER_IMPLEMENTATION_AGENT=claude
# LOOPER_IMPLEMENTATION_MODEL=provider/model
LOOPER_REVIEW_AGENT=codex
# LOOPER_REVIEW_MODEL=provider/model

# Optional harness and runtime settings.
# LOOPER_VALIDATION_COMMANDS=$'npm test\nnpm run lint\nnpm run typecheck'
# LOOPER_AGENT_TIMEOUT_SECONDS=600
# LOOPER_STATE_DIR=.looper/my-run

# Provider credentials can also be supplied here.
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# XAI_API_KEY=...
