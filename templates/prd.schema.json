{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "project", "branchName", "description", "userStories"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": { "type": "string", "minLength": 1 },
    "branchName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "userStories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "description", "sourceRefs", "scope", "nonGoals", "acceptanceCriteria", "proofExpectations", "disappointmentCheck", "dependsOn", "replaces", "priority", "passes", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "status": { "enum": ["DRAFT", "APPROVED"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
            }
          },
          "proofExpectations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1 } }
            }
          },
          "disappointmentCheck": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "replaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "priority": { "type": "integer", "minimum": 1 },
          "passes": { "type": "boolean" },
          "notes": { "type": "string" },
          "execution": { "type": "object" }
        }
      }
    }
  }
}
