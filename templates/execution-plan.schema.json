{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "description", "sourceItems", "stories"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "sourceItems": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["requirement", "constraint", "non_goal"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "stories": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/definitions/story"}
    }
  },
  "definitions": {
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "behavior", "proof", "commands"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "behavior": {"type": "string", "minLength": 1},
        "proof": {"type": "string", "minLength": 1},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "story": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "outcome", "sourceRefs", "scope", "nonGoals", "acceptanceCriteria", "dependsOn", "likelyFiles", "steps", "architectureNotes", "risks", "assumptions", "disappointmentCheck"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/criterion"}},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "likelyFiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "architectureNotes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "disappointmentCheck": {"type": "string", "minLength": 1}
      }
    }
  }
}
