{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["storyId", "contractHash", "disposition", "summary", "assumptions", "evidence", "acProof", "steps", "risks", "terminalReason", "replacementStories"],
  "properties": {
    "storyId": { "type": "string", "minLength": 1 },
    "contractHash": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["PLAN_READY", "SPLIT_REQUIRED", "BLOCKED"] },
    "summary": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "detail"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 } }
      }
    },
    "acProof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acId", "proof"],
        "properties": { "acId": { "type": "string", "minLength": 1 }, "proof": { "type": "string", "minLength": 1 } }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "files", "checks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "terminalReason": { "type": "string" },
    "replacementStories": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
