{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceHash", "baseProposalHash", "priorReviewHash", "findingIds", "revisionAttempt", "summary", "topLevelReplacements", "addSourceItems", "replaceSourceItems", "removeSourceItemIds", "addStories", "replaceStories", "removeStoryIds", "addCoverage", "replaceCoverage", "removeCoverageSourceIds"],
  "properties": {
    "sourceHash": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "baseProposalHash": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "priorReviewHash": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "findingIds": {"type":"array", "minItems":1, "uniqueItems":true, "items":{"type":"string", "minLength":1}},
    "revisionAttempt": {"type":"integer", "minimum":0},
    "summary": {"type":"string", "minLength":1},
    "topLevelReplacements": {
      "type":"object",
      "additionalProperties": false,
      "properties": {
        "project": {"type":"string", "minLength":1},
        "description": {"type":"string"},
        "disposition": {"enum":["PROPOSED","NEEDS_HUMAN"]},
        "unresolvedQuestions": {"type":"array", "items":{"type":"string", "minLength":1}},
        "terminalReason": {"type":"string"}
      }
    },
    "addSourceItems": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["id","kind","text","location"], "properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["requirement","constraint","non_goal"]},"text":{"type":"string","minLength":1},"location":{"type":"string","minLength":1}}}},
    "replaceSourceItems": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["id","kind","text","location"], "properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["requirement","constraint","non_goal"]},"text":{"type":"string","minLength":1},"location":{"type":"string","minLength":1}}}},
    "removeSourceItemIds": {"type":"array", "uniqueItems":true, "items":{"type":"string", "minLength":1}},
    "addStories": {"type":"array", "items":{"$ref":"#/definitions/story"}},
    "replaceStories": {"type":"array", "items":{"$ref":"#/definitions/story"}},
    "removeStoryIds": {"type":"array", "uniqueItems":true, "items":{"type":"string", "minLength":1}},
    "addCoverage": {"type":"array", "items":{"$ref":"#/definitions/coverage"}},
    "replaceCoverage": {"type":"array", "items":{"$ref":"#/definitions/coverage"}},
    "removeCoverageSourceIds": {"type":"array", "uniqueItems":true, "items":{"type":"string", "minLength":1}}
  },
  "definitions": {
    "criterion": {"type":"object", "additionalProperties":false, "required":["id","text"], "properties":{"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1}}},
    "proof": {"type":"object", "additionalProperties":false, "required":["id","text"], "properties":{"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"command":{"type":"string","minLength":1}}},
    "story": {
      "type":"object", "additionalProperties":false,
      "required":["id","title","description","sourceRefs","scope","nonGoals","acceptanceCriteria","proofExpectations","disappointmentCheck","dependsOn","replaces","priority"],
      "properties": {
        "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "title":{"type":"string","minLength":1}, "description":{"type":"string","minLength":1},
        "sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "scope":{"type":"array","items":{"type":"string","minLength":1}},
        "nonGoals":{"type":"array","items":{"type":"string","minLength":1}},
        "acceptanceCriteria":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/criterion"}},
        "proofExpectations":{"type":"array","items":{"$ref":"#/definitions/proof"}},
        "disappointmentCheck":{"type":"string"},
        "dependsOn":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "replaces":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "priority":{"type":"integer","minimum":1}
      }
    },
    "coverage": {"type":"object", "additionalProperties":false, "required":["sourceId","storyIds","acceptanceCriteriaIds"], "properties":{"sourceId":{"type":"string","minLength":1},"storyIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"acceptanceCriteriaIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}
  }
}
