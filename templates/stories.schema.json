{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "project", "branchName", "description", "source", "sourceInventory", "coverage", "decomposition", "stories"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "project": { "type": "string", "minLength": 1 },
    "branchName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "hash", "originalPath"],
      "properties": {
        "kind": { "enum": ["prd", "spec"] },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "originalPath": { "type": "string", "minLength": 1 }
      }
    },
    "sourceInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "location"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["requirement", "constraint", "non_goal"] },
          "text": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "storyIds", "acceptanceCriteriaIds"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "storyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "acceptanceCriteriaIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "decomposition": {
      "type": "object",
      "required": ["kind", "status", "round", "proposalHash", "reviewHash", "sourceHash", "author", "reviewer", "approvedAt"],
      "properties": {
        "kind": { "const": "adversarial_decomposition_review" },
        "status": { "const": "APPROVED" },
        "round": { "type": "integer", "minimum": 1 },
        "proposalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "author": { "type": "object", "required": ["agent", "model"], "properties": { "agent": {"type":"string","minLength":1}, "model": {"type":"string"} } },
        "reviewer": { "type": "object", "required": ["agent", "model"], "properties": { "agent": {"type":"string","minLength":1}, "model": {"type":"string"} } },
        "approvedAt": { "type": "string", "minLength": 1 }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "description", "sourceRefs", "scope", "nonGoals", "acceptanceCriteria", "proofExpectations", "disappointmentCheck", "dependsOn", "replaces", "priority", "passes", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "status": { "const": "APPROVED" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptanceCriteria": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } }
          },
          "proofExpectations": {
            "type": "array",
            "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1 } } }
          },
          "disappointmentCheck": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "replaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "priority": { "type": "integer", "minimum": 1 },
          "passes": { "type": "boolean" },
          "notes": { "type": "string" },
          "execution": { "type": "object" }
        }
      }
    }
  }
}
