{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceKind", "sourceHash", "disposition", "project", "description", "sourceInventory", "coverage", "stories", "unresolvedQuestions", "terminalReason"],
  "properties": {
    "sourceKind": { "enum": ["prd", "spec"] },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disposition": { "enum": ["PROPOSED", "NEEDS_HUMAN"], "description": "PROPOSED requires unresolvedQuestions=[] and terminalReason=\"\". NEEDS_HUMAN requires one or more unresolved questions and a non-empty human-decision reason." },
    "project": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sourceInventory": {
      "type": "array",
      "description": "Stable, globally unique source item IDs.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "text", "location"],
        "properties": { "id": {"type":"string"}, "kind": {"enum":["requirement","constraint","non_goal"]}, "text": {"type":"string"}, "location": {"type":"string"} }
      }
    },
    "coverage": {
      "type": "array",
      "description": "Exactly one entry per source inventory item. Story and acceptance IDs must exist, and each acceptance criterion must be owned by one of the mapped stories.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "storyIds", "acceptanceCriteriaIds"],
        "properties": {
          "sourceId": {"type":"string", "minLength":1},
          "storyIds": {"type":"array", "minItems":1, "uniqueItems":true, "items":{"type":"string", "minLength":1}},
          "acceptanceCriteriaIds": {"type":"array", "uniqueItems":true, "items":{"type":"string", "minLength":1}}
        }
      }
    },
    "stories": {
      "type": "array",
      "description": "Dependency-ordered stories with globally unique story and acceptance-criterion IDs.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "description", "sourceRefs", "scope", "nonGoals", "acceptanceCriteria", "proofExpectations", "disappointmentCheck", "dependsOn", "replaces", "priority"],
        "properties": {
          "id": {"type":"string"}, "title": {"type":"string"}, "description": {"type":"string"},
          "sourceRefs": {"type":"array", "minItems":1, "uniqueItems":true, "description":"Must exactly equal the source IDs whose coverage storyIds include this story.", "items":{"type":"string", "minLength":1}},
          "scope": {"type":"array", "items":{"type":"string"}},
          "nonGoals": {"type":"array", "items":{"type":"string"}},
          "acceptanceCriteria": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["id","text"], "properties":{"id":{"type":"string"},"text":{"type":"string"}}}},
          "proofExpectations": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["id","text"], "properties":{"id":{"type":"string"},"text":{"type":"string"},"command":{"type":"string","minLength":1}}}},
          "disappointmentCheck": {"type":"string"},
          "dependsOn": {"type":"array", "uniqueItems":true, "description":"May reference only known stories appearing earlier in the stories array.", "items":{"type":"string", "minLength":1}},
          "replaces": {"type":"array", "uniqueItems":true, "items":{"type":"string", "minLength":1}},
          "priority": {"type":"integer", "minimum":1}
        }
      }
    },
    "unresolvedQuestions": { "type": "array", "items": {"type":"string"}, "description": "Exactly [] for PROPOSED; at least one material human decision for NEEDS_HUMAN." },
    "terminalReason": { "type": "string", "description": "Exactly empty for PROPOSED. For NEEDS_HUMAN, a non-empty description of the required human decision; never a completion summary or N/A." }
  }
}
