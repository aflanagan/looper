#!/bin/bash
# Looper - Autonomous Claude + Codex Loop
# Runs Claude Code and Codex review repeatedly until all PRD tasks complete.
#
# Usage: looper [max_iterations]
# Default: 10 iterations
#
# Requires:
#   - .looper/prd.json in current directory
#   - codex, claude, jq, git
#
# Optional:
#   - .looper/config.md for project-specific quality checks/context
#   - .looper/prompt.local.md for project-specific prompt addendum
#   - .looper/codex-review-prompt.md to override the default review prompt template
#   - LOOPER_STATE_DIR to override .looper location
#   - LOOPER_REVIEW_MAX_ROUNDS (default 3)
#   - LOOPER_REVIEW_PROMPT_FILE / LOOPER_REVIEW_SCHEMA_FILE to override review artifacts

set -euo pipefail

# Find the looper installation directory (resolve symlinks)
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
LOOPER_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

MAX_ITERATIONS=${1:-10}
PROJECT_DIR="$PWD"

if [ -n "${LOOPER_STATE_DIR:-}" ]; then
    case "$LOOPER_STATE_DIR" in
        /*) STATE_DIR="$LOOPER_STATE_DIR" ;;
        *) STATE_DIR="$PROJECT_DIR/$LOOPER_STATE_DIR" ;;
    esac
else
    STATE_DIR="$PROJECT_DIR/.looper"
fi

CONFIG_FILE="$STATE_DIR/config.md"
LOCAL_PROMPT_FILE="$STATE_DIR/prompt.local.md"
PRD_FILE="$STATE_DIR/prd.json"
PROGRESS_FILE="$STATE_DIR/progress.txt"
LAST_BRANCH_FILE="$STATE_DIR/.last-branch"
ARCHIVE_DIR="$STATE_DIR/archive"
REVIEWS_ROOT="$STATE_DIR/reviews"
PROMPT_FILE="$LOOPER_DIR/templates/looper-prompt.md"
REVIEW_PROMPT_FILE="${LOOPER_REVIEW_PROMPT_FILE:-$STATE_DIR/codex-review-prompt.md}"
REVIEW_SCHEMA_FILE="${LOOPER_REVIEW_SCHEMA_FILE:-$LOOPER_DIR/templates/codex-review-schema.json}"
REVIEW_MAX_ROUNDS="${LOOPER_REVIEW_MAX_ROUNDS:-3}"

if [ ! -f "$REVIEW_PROMPT_FILE" ]; then
    REVIEW_PROMPT_FILE="$LOOPER_DIR/templates/codex-review-prompt.md"
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

require_command() {
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo -e "${RED}Error: required command '$cmd' not found in PATH.${NC}"
        exit 1
    fi
}

get_active_story_id() {
    jq -r '[.userStories[] | select(.passes == false)] | sort_by(.priority, .id) | .[0].id // empty' "$PRD_FILE"
}

get_story_title() {
    local story_id="$1"
    jq -r --arg id "$story_id" '.userStories[] | select(.id == $id) | .title // empty' "$PRD_FILE"
}

has_uncommitted_changes() {
    if ! git -C "$PROJECT_DIR" diff --quiet; then
        return 0
    fi
    if ! git -C "$PROJECT_DIR" diff --cached --quiet; then
        return 0
    fi
    [ -n "$(git -C "$PROJECT_DIR" ls-files --others --exclude-standard)" ]
}

mark_story_passed() {
    local story_id="$1"
    local tmp
    tmp="$(mktemp "$STATE_DIR/prd.XXXXXX")"
    jq --arg id "$story_id" '(.userStories[] | select(.id == $id) | .passes) = true' "$PRD_FILE" > "$tmp"
    mv "$tmp" "$PRD_FILE"
}

stage_and_commit_story() {
    local story_id="$1"
    local story_title="$2"
    local rel_state_dir

    git -C "$PROJECT_DIR" add -A

    if [[ "$STATE_DIR" == "$PROJECT_DIR/"* ]]; then
        rel_state_dir="${STATE_DIR#$PROJECT_DIR/}"
        # Review artifacts are runtime data and should not be committed.
        git -C "$PROJECT_DIR" reset -q -- "$rel_state_dir/reviews" 2>/dev/null || true
    fi

    if git -C "$PROJECT_DIR" diff --cached --quiet; then
        echo -e "${YELLOW}No staged changes to commit for $story_id.${NC}"
        return 1
    fi

    if [ -z "$story_title" ]; then
        story_title="Story"
    fi
    git -C "$PROJECT_DIR" commit -m "[Looper] $story_id: $story_title"
}

build_claude_input() {
    local phase="$1"
    local story_id="$2"
    local review_file="${3:-}"

    cat "$PROMPT_FILE"

    echo ""
    echo "---"
    echo ""
    echo "## Looper Runtime Context"
    echo "- Active story id: $story_id"
    echo "- Commit changes: NO (Looper commits after Codex review approval)."
    echo "- Set \`passes\` to true: NO (Looper updates \`prd.json\` after Codex approval)."

    if [ "$phase" = "remediation" ]; then
        echo "- Phase: remediation"
        echo "- Review findings artifact to address: $review_file"
        echo "- Apply accepted fixes, rerun quality checks, and update progress notes."
    else
        echo "- Phase: implementation"
    fi

    if [ -f "$LOCAL_PROMPT_FILE" ]; then
        echo ""
        echo "---"
        echo ""
        echo "## Project Local Addendum ($LOCAL_PROMPT_FILE)"
        echo "Apply the following additional project-specific instructions in addition to the base Looper template:"
        echo ""
        cat "$LOCAL_PROMPT_FILE"
    fi
}

run_claude_phase() {
    local phase="$1"
    local story_id="$2"
    local review_file="${3:-}"

    echo "Running Claude phase '$phase' for $story_id..."
    build_claude_input "$phase" "$story_id" "$review_file" | claude --dangerously-skip-permissions >/dev/null
}

run_codex_review_round() {
    local story_id="$1"
    local story_title="$2"
    local round="$3"
    local previous_review_file="${4:-}"

    local branch_slug review_dir review_file events_file prompt_input_file
    branch_slug="$(jq -r '.branchName // "unknown-branch"' "$PRD_FILE" | sed 's#[^A-Za-z0-9._-]#-#g')"
    review_dir="$REVIEWS_ROOT/$branch_slug/$story_id"
    review_file="$review_dir/round-$round.json"
    events_file="$review_dir/round-$round-events.jsonl"

    mkdir -p "$review_dir"
    prompt_input_file="$(mktemp "$STATE_DIR/codex-review-input.XXXXXX.md")"

    {
        cat "$REVIEW_PROMPT_FILE"
        echo ""
        echo "## Runtime Context"
        echo "- Active story ID: $story_id"
        echo "- Active story title: $story_title"
        echo "- Review round: $round"
        if [ -n "$previous_review_file" ]; then
            echo "- Previous review artifact: $previous_review_file"
        fi
    } > "$prompt_input_file"

    echo "Running Codex review round $round for $story_id..."
    codex -a never -s workspace-write exec --ephemeral --json --output-schema "$REVIEW_SCHEMA_FILE" -o "$review_file" - < "$prompt_input_file" > "$events_file"

    rm -f "$prompt_input_file"
    echo "$review_file"
}

echo -e "${GREEN}Looper starting...${NC}"
echo "Project: $PROJECT_DIR"
echo "State dir: $STATE_DIR"
echo "Max iterations: $MAX_ITERATIONS"
echo "Codex review rounds per story: $REVIEW_MAX_ROUNDS"

# Validate prerequisites.
if ! [[ "$REVIEW_MAX_ROUNDS" =~ ^[0-9]+$ ]] || [ "$REVIEW_MAX_ROUNDS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_REVIEW_MAX_ROUNDS must be a positive integer.${NC}"
    exit 1
fi

require_command git
require_command jq
require_command claude
require_command codex

if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${RED}Error: Looper must run inside a git repository.${NC}"
    exit 1
fi

if [ ! -d "$STATE_DIR" ]; then
    echo -e "${RED}Error: state directory not found: $STATE_DIR${NC}"
    echo "Create $PROJECT_DIR/.looper/prd.json first (use /looper skill to convert a PRD)."
    exit 1
fi

if [ ! -f "$PRD_FILE" ]; then
    echo -e "${RED}Error: $PRD_FILE not found.${NC}"
    echo "Create a PRD first (use /prd skill), then convert it (use /looper skill)."
    exit 1
fi

if [ ! -f "$PROMPT_FILE" ]; then
    echo -e "${RED}Error: Prompt template not found at $PROMPT_FILE${NC}"
    echo "Looper installation may be broken. Re-run install.sh"
    exit 1
fi

if [ ! -f "$REVIEW_PROMPT_FILE" ]; then
    echo -e "${RED}Error: Codex review prompt template not found at $REVIEW_PROMPT_FILE${NC}"
    exit 1
fi

if [ ! -f "$REVIEW_SCHEMA_FILE" ]; then
    echo -e "${RED}Error: Codex review schema not found at $REVIEW_SCHEMA_FILE${NC}"
    exit 1
fi

# Show config status
if [ -f "$CONFIG_FILE" ]; then
    echo "Project config: $CONFIG_FILE"
else
    echo -e "${YELLOW}No project config ($CONFIG_FILE) - using defaults${NC}"
fi

if [ -f "$LOCAL_PROMPT_FILE" ]; then
    echo "Project prompt addendum: $LOCAL_PROMPT_FILE"
fi

# Branch change detection & archiving
if [ -f "$LAST_BRANCH_FILE" ]; then
    LAST_BRANCH="$(cat "$LAST_BRANCH_FILE")"
    CURRENT_BRANCH="$(jq -r '.branchName' "$PRD_FILE")"

    if [ "$LAST_BRANCH" != "$CURRENT_BRANCH" ] && [ -n "$LAST_BRANCH" ]; then
        echo -e "${YELLOW}Branch changed from $LAST_BRANCH to $CURRENT_BRANCH${NC}"
        echo "Archiving previous run..."

        BRANCH_SLUG="$(echo "$LAST_BRANCH" | sed -e 's#^looper/##')"
        ARCHIVE_NAME="$(date +%Y-%m-%d)-$BRANCH_SLUG"
        mkdir -p "$ARCHIVE_DIR/$ARCHIVE_NAME"

        [ -f "$PROGRESS_FILE" ] && cp "$PROGRESS_FILE" "$ARCHIVE_DIR/$ARCHIVE_NAME/"
        rm -f "$PROGRESS_FILE"
        echo -e "${GREEN}Previous run archived to $ARCHIVE_DIR/$ARCHIVE_NAME${NC}"
    fi
fi

CURRENT_BRANCH="$(jq -r '.branchName' "$PRD_FILE")"
echo "$CURRENT_BRANCH" > "$LAST_BRANCH_FILE"

# Initialize progress file if missing
if [ ! -f "$PROGRESS_FILE" ]; then
    echo "# Looper Progress Log" > "$PROGRESS_FILE"
    echo "Started: $(date)" >> "$PROGRESS_FILE"
    echo "---" >> "$PROGRESS_FILE"
    echo "" >> "$PROGRESS_FILE"
    echo "## Codebase Patterns" >> "$PROGRESS_FILE"
    echo "(Patterns discovered during implementation)" >> "$PROGRESS_FILE"
    echo "---" >> "$PROGRESS_FILE"
    echo "" >> "$PROGRESS_FILE"
fi

for i in $(seq 1 "$MAX_ITERATIONS"); do
    echo ""
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "${GREEN}  Looper iteration $i of $MAX_ITERATIONS${NC}"
    echo -e "${GREEN}=======================================================${NC}"
    echo ""

    INCOMPLETE="$(jq '[.userStories[] | select(.passes == false)] | length' "$PRD_FILE")"
    if [ "$INCOMPLETE" -eq 0 ]; then
        echo -e "${GREEN}All stories complete! Looper is done.${NC}"
        exit 0
    fi

    ACTIVE_STORY_ID="$(get_active_story_id)"
    ACTIVE_STORY_TITLE="$(get_story_title "$ACTIVE_STORY_ID")"

    if [ -z "$ACTIVE_STORY_ID" ]; then
        echo -e "${RED}Error: Could not determine active story.${NC}"
        exit 1
    fi

    echo "Active story: $ACTIVE_STORY_ID - $ACTIVE_STORY_TITLE"

    run_claude_phase "implementation" "$ACTIVE_STORY_ID"

    if ! has_uncommitted_changes; then
        echo -e "${YELLOW}No uncommitted changes after Claude implementation for $ACTIVE_STORY_ID; skipping review.${NC}"
        sleep 2
        continue
    fi

    APPROVED=false
    PREVIOUS_REVIEW_FILE=""

    for round in $(seq 1 "$REVIEW_MAX_ROUNDS"); do
        REVIEW_FILE="$(run_codex_review_round "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$round" "$PREVIOUS_REVIEW_FILE")"
        VERDICT="$(jq -r '.verdict // empty' "$REVIEW_FILE")"

        if [ "$VERDICT" = "APPROVED" ]; then
            echo -e "${GREEN}Codex review APPROVED ($ACTIVE_STORY_ID, round $round).${NC}"
            APPROVED=true
            break
        fi

        if [ "$VERDICT" != "CHANGES_REQUESTED" ]; then
            echo -e "${RED}Error: invalid Codex verdict '$VERDICT' in $REVIEW_FILE${NC}"
            exit 1
        fi

        echo -e "${YELLOW}Codex requested changes ($ACTIVE_STORY_ID, round $round).${NC}"
        PREVIOUS_REVIEW_FILE="$REVIEW_FILE"

        if [ "$round" -lt "$REVIEW_MAX_ROUNDS" ]; then
            run_claude_phase "remediation" "$ACTIVE_STORY_ID" "$REVIEW_FILE"
        fi
    done

    if [ "$APPROVED" != "true" ]; then
        echo -e "${YELLOW}Max Codex review rounds reached for $ACTIVE_STORY_ID without approval. Leaving changes uncommitted.${NC}"
        sleep 2
        continue
    fi

    mark_story_passed "$ACTIVE_STORY_ID"
    stage_and_commit_story "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" || true

    echo "Iteration $i complete. Pausing 2 seconds..."
    sleep 2
done

echo -e "${RED}Max iterations ($MAX_ITERATIONS) reached without completion.${NC}"
echo "Check .looper/progress.txt and .looper/prd.json for status."
exit 1
