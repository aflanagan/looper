    echo "Running Codex phase '$phase' for $story_id..."

    phase_label="Codex $phase"
    if [ "$phase" = "remediation" ] && [ -n "$review_round" ]; then
        phase_label="$phase_label (after round $review_round)"
        log_file="$RUN_DIR/iter-${i}-codex-${phase}-round-${review_round}.log"
    else
        log_file="$RUN_DIR/iter-${i}-codex-${phase}.log"
    fi

    prompt_input_file="$RUN_DIR/iter-${i}-codex-${phase}.prompt.txt"
    build_phase_input "$phase" "$story_id" "$story_title" "$story_file" "$review_round" > "$prompt_input_file"

    run_with_log "$story_id" "$ACTIVE_STORY_TITLE" \
        "codex" "$phase_label" "$log_file" "plain" \
        bash -c 'cat "$1" | "$3" exec -s danger-full-access -C "$2" --skip-git-repo-check --ephemeral -' -- \
        "$prompt_input_file" "$PROJECT_DIR" "$CODEX_BIN"
}

run_claude_review_round() {
    local story_id="$1"
    local story_title="$2"
    local round="$3"
    local story_file="$4"

    local review_json_tmp review_input_file log_file review_schema_json
    review_json_tmp="$(mktemp "$RUN_DIR/review-round-${story_id}-${round}.XXXXXX.json")"
    review_input_file="$RUN_DIR/iter-${i}-claude-review-round-${round}.prompt.txt"
    log_file="$RUN_DIR/iter-${i}-claude-review-round-${round}.log"
    review_schema_json="$(cat "$REVIEW_SCHEMA_FILE")"

    echo "Running Claude review round $round for $story_id..." >&2
    build_review_input "$story_id" "$story_title" "$round" "$story_file" > "$review_input_file"

    run_with_log "$story_id" "$story_title" \
        "claude-review" "Claude review round $round" "$log_file" "plain" \
        bash -lc 'cat "$1" | claude -p --dangerously-skip-permissions --output-format json --json-schema "$2" | jq ".structured_output // (.result | fromjson? // {})" > "$3"; cat "$3"' -- \
        "$review_input_file" "$review_schema_json" "$review_json_tmp"

    REVIEW_JSON_RESULT="$review_json_tmp"
}

run_codex_review_round() {
    local story_id="$1"
    local story_title="$2"
    local round="$3"
    local story_file="$4"

    local review_json_tmp review_input_file events_file
    review_json_tmp="$(mktemp "$RUN_DIR/review-round-${story_id}-${round}.XXXXXX.json")"
    review_input_file="$RUN_DIR/iter-${i}-codex-review-round-${round}.prompt.txt"
    events_file="$RUN_DIR/iter-${i}-codex-review-round-${round}.jsonl"

    echo "Running Codex review round $round for $story_id..." >&2
    build_review_input "$story_id" "$story_title" "$round" "$story_file" > "$review_input_file"

    run_with_log "$story_id" "$story_title" \
        "codex" "Codex review round $round" "$events_file" "codex-jsonl" \
        bash -c 'cat "$1" | "$4" -a never -s workspace-write exec --ephemeral --json --output-schema "$2" -o "$3" -' -- \
        "$review_input_file" "$REVIEW_SCHEMA_FILE" "$review_json_tmp" "$CODEX_BIN"

    REVIEW_JSON_RESULT="$review_json_tmp"
}

# Run `opencode run` headless, reading the prompt from stdin, streaming raw JSON
# events to stdout. Model is optional: unset lets opencode use its default.
opencode_run_stdin() {
    local prompt_file="$1"
    local model="$2"
    local dir="$3"
    local mode="${4:-auto}"
    bash -lc '
        prompt="$1"; model="$2"; dir="$3"; mode="$4"
        set -- run --format json --dir "$dir"
        if [ "$mode" = "auto" ]; then set -- "$@" --auto; fi
        [ -n "$model" ] && set -- "$@" --model "$model"
        cat "$prompt" | opencode "$@"
    ' -- "$prompt_file" "$model" "$dir" "$mode"
}

# Pull the assistant text out of an opencode JSON-event log, extract the first
# balanced JSON object, and validate it against the review schema shape
# (mirrors templates/codex-review-schema.json). On success, write the object to
# $out_json and return 0; otherwise return 1.
extract_opencode_review_json() {
    local events_file="$1"
    local out_json="$2"
    local assistant_text candidate

    assistant_text="$(jq -rs 'map(select((.type // "") == "text") | .part.text // "") | join("")' "$events_file" 2>/dev/null || true)"
    if [ -z "$assistant_text" ]; then
        return 1
    fi

    # Extract the first complete top-level JSON object, ignoring any prose or
    # markdown fences the model may have wrapped around it.
    candidate="$(printf '%s' "$assistant_text" | awk '
        BEGIN { started=0; depth=0; instr=0; esc=0; buf="" }
        {
            n = length($0)
            for (i = 1; i <= n; i++) {
                c = substr($0, i, 1)
                if (!started) {
                    if (c == "{") { started=1; depth=1; buf="{" }
                    continue
                }
                buf = buf c
                if (instr) {
                    if (esc) { esc=0 }
                    else if (c == "\\") { esc=1 }
                    else if (c == "\"") { instr=0 }
                } else {
                    if (c == "\"") { instr=1 }
                    else if (c == "{") { depth++ }
                    else if (c == "}") { depth--; if (depth == 0) { print buf; exit } }
                }
            }
            if (started) { buf = buf "\n" }
        }
    ')"

    if [ -z "$candidate" ]; then
        return 1
    fi

    # Validate structural conformance to the review schema. jq -e exits non-zero
    # on a parse error or when the final result is false/null.
    if ! printf '%s' "$candidate" | jq -e '
        (.verdict | IN("APPROVED","CHANGES_REQUESTED"))
        and (.summary | type == "string" and (length > 0))
        and (.findings | type == "array")
        and (all(.findings[]?;
              (.id | type == "string" and (length > 0))
              and (.priority | IN("P0","P1","P2","P3"))
              and (.title | type == "string" and (length > 0))
              and (.details | type == "string" and (length > 0))
              and (.location | type == "string" and (length > 0))
              and (.axis | IN("standards","spec"))))
        and (.acCoverage | type == "array")
        and (all(.acCoverage[]?;
              (.criterionId | type == "string" and (length > 0))
              and (.criterion | type == "string" and (length > 0))
              and (.status | IN("pass","fail"))
              and (.details | type == "string" and (length > 0))))
        and (.testGaps | type == "array")
        and (all(.testGaps[]?; type == "string"))
    ' >/dev/null 2>&1; then
        return 1
    fi

    # Normalize (compact/canonical) into the output file for downstream jq.
    printf '%s' "$candidate" | jq '.' > "$out_json"
}

run_opencode_phase() {
    local phase="$1"
    local story_id="$2"
    local story_title="$3"
    local story_file="$4"
    local review_round="${5:-}"
    local prompt_input_file log_file phase_label

    echo "Running opencode phase '$phase' for $story_id..."

    phase_label="opencode $phase"
    if [ "$phase" = "remediation" ] && [ -n "$review_round" ]; then
        phase_label="$phase_label (after round $review_round)"
        log_file="$RUN_DIR/iter-${i}-opencode-${phase}-round-${review_round}.jsonl"
    else
        log_file="$RUN_DIR/iter-${i}-opencode-${phase}.jsonl"
    fi

    prompt_input_file="$RUN_DIR/iter-${i}-opencode-${phase}.prompt.txt"
    build_phase_input "$phase" "$story_id" "$story_title" "$story_file" "$review_round" > "$prompt_input_file"

    run_with_log "$story_id" "$ACTIVE_STORY_TITLE" \
        "opencode" "$phase_label" "$log_file" "opencode-jsonl" \
        opencode_run_stdin "$prompt_input_file" "$IMPLEMENTATION_MODEL" "$PROJECT_DIR" "auto"
}

run_opencode_review_round() {
    local story_id="$1"
    local story_title="$2"
    local round="$3"
    local story_file="$4"

    local review_json_tmp review_input_file events_file
    local repair_input_file repair_events_file schema_json prev_text
    review_json_tmp="$(mktemp "$RUN_DIR/review-round-${story_id}-${round}.XXXXXX.json")"
    review_input_file="$RUN_DIR/iter-${i}-opencode-review-round-${round}.prompt.txt"
    events_file="$RUN_DIR/iter-${i}-opencode-review-round-${round}.jsonl"
    repair_input_file="$RUN_DIR/iter-${i}-opencode-review-round-${round}.repair.prompt.txt"
    repair_events_file="$RUN_DIR/iter-${i}-opencode-review-round-${round}.repair.jsonl"
    schema_json="$(cat "$REVIEW_SCHEMA_FILE")"

    echo "Running opencode review round $round for $story_id..." >&2
    build_review_input "$story_id" "$story_title" "$round" "$story_file" > "$review_input_file"

    # opencode has no schema-constrained output mode, so inject the schema and a
    # strict JSON-only contract into the prompt itself.
    {
        echo ""
        echo "---"
        echo ""
        echo "## Output Contract (opencode)"
        echo ""
        echo "Return ONLY a single JSON object and nothing else: no markdown code"
        echo "fences, no prose before or after. The object MUST conform to this"
        echo "JSON Schema:"
        echo ""
        echo '```json'
        echo "$schema_json"
        echo '```'
        echo ""
        echo 'Every required field must be present. "verdict" must be exactly'
        echo '"APPROVED" or "CHANGES_REQUESTED".'
    } >> "$review_input_file"

    run_with_log "$story_id" "$story_title" \
        "opencode-review" "opencode review round $round" "$events_file" "opencode-jsonl" \
        opencode_run_stdin "$review_input_file" "$REVIEW_MODEL" "$PROJECT_DIR" "auto"

    if extract_opencode_review_json "$events_file" "$review_json_tmp"; then
        REVIEW_JSON_RESULT="$review_json_tmp"
        return 0
    fi

    echo -e "${YELLOW}opencode review round $round did not return schema-valid JSON; attempting one repair round.${NC}" >&2

    prev_text="$(jq -rs 'map(select((.type // "") == "text") | .part.text // "") | join("")' "$events_file" 2>/dev/null || true)"
    {
        echo "Your previous response was NOT a valid JSON object matching the"
        echo "required review schema. Output ONLY a single JSON object conforming"
        echo "to this JSON Schema, with no markdown fences and no prose:"
        echo ""
        echo '```json'
        echo "$schema_json"
        echo '```'
        echo ""
        echo 'Reuse the substance of the review you already produced below and'
        echo "re-encode it as schema-valid JSON. Do not re-run any tools."
        echo ""
        echo "--- your previous (invalid) output ---"
        echo "$prev_text"
    } > "$repair_input_file"

    run_with_log "$story_id" "$story_title" \
        "opencode-review" "opencode review round $round (repair)" "$repair_events_file" "opencode-jsonl" \
        opencode_run_stdin "$repair_input_file" "$REVIEW_MODEL" "$PROJECT_DIR" "auto"

    if ! extract_opencode_review_json "$repair_events_file" "$review_json_tmp"; then
        echo -e "${RED}Error: opencode review round $round failed to produce schema-valid JSON after one repair attempt.${NC}" >&2
        # Leave an empty object so downstream verdict handling fails loudly
        # rather than crashing on a missing/garbage file.
        echo '{}' > "$review_json_tmp"
    fi

    REVIEW_JSON_RESULT="$review_json_tmp"
}

run_harness_validations() {
    local story_id="$1" validation_file command command_id=0 failed=0 log_file tmp
    validation_file="$STORIES_ROOT/${story_id}.validation.json"
    tmp="$(mktemp "$STATE_DIR/validation.XXXXXX")"
    echo '[]' > "$tmp"
    set_active_phase "VALIDATING"

    while IFS= read -r command || [ -n "$command" ]; do
        [ -n "$command" ] || continue
        command_id=$((command_id + 1))
        log_file="$RUN_DIR/${story_id}-validation-${command_id}.log"
        echo "Running harness validation $command_id: $command"
        if run_with_log "$story_id" "$ACTIVE_STORY_TITLE" "validation" "Harness validation $command_id" "$log_file" "plain" \
            bash -lc "$command"; then
            jq --arg command "$command" --arg log "$(display_path "$log_file")" '. += [{command:$command,status:"pass",log:$log}]' "$tmp" > "$tmp.next"
        else
            jq --arg command "$command" --arg log "$(display_path "$log_file")" '. += [{command:$command,status:"fail",log:$log}]' "$tmp" > "$tmp.next"
            failed=1
        fi
        mv "$tmp.next" "$tmp"
    done < <(
        if [ -n "$VALIDATION_COMMANDS" ]; then printf '%s\n' "$VALIDATION_COMMANDS"; fi
        jq -r '.proofExpectations[]? | .command // empty' "$ACTIVE_CONTRACT_FILE"
    )

    mv "$tmp" "$validation_file"
    if [ "$failed" -ne 0 ]; then
        set_active_phase "VALIDATION_FAILED"
        ensure_story_state_file "$story_id" "$ACTIVE_STORY_TITLE"
        replace_story_section "$ACTIVE_STORY_FILE" "current-status" "- Phase: validation failed
- Review round: 0
- Latest review verdict: VALIDATION_FAILED
- Last updated: $(utc_timestamp)"
        replace_story_section "$ACTIVE_STORY_FILE" "open-findings" "- Harness-owned validation failed. Inspect $(display_path "$validation_file") and its logs, fix the implementation, and rerun every check."
        append_story_history_entry "$ACTIVE_STORY_FILE" "Harness validation failed; remediation is required before code review."
        echo -e "${RED}Error: harness validation failed for $story_id. See $(display_path "$validation_file").${NC}"
        return 1
    fi
    set_active_phase "VALIDATED"
    return 0
}

run_implementation_phase() {
    local phase="$1"
    local story_id="$2"
    local story_title="$3"
    local review_round="${4:-}"

    set_active_phase "IMPLEMENTING"
    prepare_story_handoff_section "$story_id" "$story_title" "$phase" "$review_round"

    case "$IMPLEMENTATION_AGENT" in
        claude) run_claude_phase "$phase" "$story_id" "$story_title" "$ACTIVE_STORY_FILE" "$review_round" ;;
        codex) run_codex_phase "$phase" "$story_id" "$story_title" "$ACTIVE_STORY_FILE" "$review_round" ;;
        opencode) run_opencode_phase "$phase" "$story_id" "$story_title" "$ACTIVE_STORY_FILE" "$review_round" ;;
    esac

    validate_story_handoff_section "$story_id" "$ACTIVE_STORY_FILE"
    record_implementation_history "$story_id" "$phase" "$review_round" "$ACTIVE_STORY_FILE"
    run_harness_validations "$story_id"
}

run_review_round() {
    local story_id="$1"
    local story_title="$2"
    local round="$3"
    local story_file="$4"

    set_active_phase "CODE_REVIEW"
    case "$REVIEW_AGENT" in
        claude) run_claude_review_round "$story_id" "$story_title" "$round" "$story_file" ;;
        codex) run_codex_review_round "$story_id" "$story_title" "$round" "$story_file" ;;
        opencode) run_opencode_review_round "$story_id" "$story_title" "$round" "$story_file" ;;
    esac
}

validate_code_review_semantics() {
    local review_file="$1" expected actual
    if ! jq -e '
      (.verdict | IN("APPROVED","CHANGES_REQUESTED"))
      and (.summary | type == "string" and length > 0)
      and (.findings | type == "array") and (.acCoverage | type == "array") and (.testGaps | type == "array")
      and all(.findings[]?; (.axis | IN("standards","spec")))
      and (if .verdict == "APPROVED" then
             (.findings | length) == 0 and (.testGaps | length) == 0 and all(.acCoverage[]; .status == "pass")
           else true end)
    ' "$review_file" >/dev/null; then
        echo -e "${RED}Error: code review output violates approval invariants.${NC}"
        exit 1
    fi
    expected="$(jq -c '[.acceptanceCriteria[] | {id:.id,text:.text}] | sort_by(.id)' "$ACTIVE_CONTRACT_FILE")"
    actual="$(jq -c '[.acCoverage[] | {id:.criterionId,text:.criterion}] | sort_by(.id)' "$review_file")"
    if [ "$expected" != "$actual" ]; then
        echo -e "${RED}Error: code review must evaluate every locked acceptance criterion exactly once by stable ID.${NC}"
        exit 1
    fi
}

if [ "$MODE" = "help" ]; then
    print_usage
    exit 0
fi

echo -e "${GREEN}Looper starting...${NC}"
echo "Project: $PROJECT_DIR"
echo "State dir: $STATE_DIR"
if [ "$MODE" = "watch" ]; then
    echo "Mode: watch ($WATCH_OUTPUT_MODE)"
else
    echo "Max iterations: $MAX_ITERATIONS"
    echo "Implementation agent: $(agent_display_name "$IMPLEMENTATION_AGENT")"
    if [ "$IMPLEMENTATION_AGENT" = "opencode" ]; then
        echo "Implementation model: ${IMPLEMENTATION_MODEL:-<opencode default>}"
    fi
    echo "Review agent: $(agent_display_name "$REVIEW_AGENT")"
    if [ "$REVIEW_AGENT" = "opencode" ]; then
        echo "Review model: ${REVIEW_MODEL:-<opencode default>}"
    fi
    echo "Review rounds per story: $REVIEW_MAX_ROUNDS"
    echo "Plan review rounds per story: $PLAN_REVIEW_MAX_ROUNDS"
fi

# Validate prerequisites.
if [ "$MODE" != "watch" ]; then
    if ! [[ "$MAX_ITERATIONS" =~ ^[0-9]+$ ]] || [ "$MAX_ITERATIONS" -lt 1 ]; then
        echo -e "${RED}Error: max_iterations must be a positive integer.${NC}"
        exit 1
    fi
fi
if ! [[ "$REVIEW_MAX_ROUNDS" =~ ^[0-9]+$ ]] || [ "$REVIEW_MAX_ROUNDS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_REVIEW_MAX_ROUNDS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$PLAN_REVIEW_MAX_ROUNDS" =~ ^[0-9]+$ ]] || [ "$PLAN_REVIEW_MAX_ROUNDS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_PLAN_REVIEW_MAX_ROUNDS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$DECOMPOSITION_REVIEW_MAX_ROUNDS" =~ ^[0-9]+$ ]] || [ "$DECOMPOSITION_REVIEW_MAX_ROUNDS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_DECOMPOSITION_REVIEW_MAX_ROUNDS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$DECOMPOSITION_OUTPUT_REPAIR_MAX_ATTEMPTS" =~ ^[0-9]+$ ]] || [ "$DECOMPOSITION_OUTPUT_REPAIR_MAX_ATTEMPTS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_DECOMPOSITION_OUTPUT_REPAIR_MAX_ATTEMPTS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$DECOMPOSITION_REVIEW_OUTPUT_REPAIR_MAX_ATTEMPTS" =~ ^[0-9]+$ ]] || [ "$DECOMPOSITION_REVIEW_OUTPUT_REPAIR_MAX_ATTEMPTS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_DECOMPOSITION_REVIEW_OUTPUT_REPAIR_MAX_ATTEMPTS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$DECOMPOSITION_AGENT_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || [ "$DECOMPOSITION_AGENT_TIMEOUT_SECONDS" -lt 1 ]; then
    echo -e "${RED}Error: LOOPER_DECOMPOSITION_AGENT_TIMEOUT_SECONDS must be a positive integer.${NC}"
    exit 1
fi
if ! [[ "$DECOMPOSITION_TIMEOUT_MAX_RETRIES" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Error: LOOPER_DECOMPOSITION_TIMEOUT_MAX_RETRIES must be a non-negative integer.${NC}"
    exit 1
fi
if ! [[ "$KEEP_LOGS" =~ ^[01]$ ]]; then
    echo -e "${RED}Error: LOOPER_KEEP_LOGS must be 0 or 1.${NC}"
    exit 1
fi
validate_agent_name "$IMPLEMENTATION_AGENT" "LOOPER_IMPLEMENTATION_AGENT"
validate_agent_name "$REVIEW_AGENT" "LOOPER_REVIEW_AGENT"

require_command git
require_command jq

if [ "$MODE" != "watch" ]; then
    if [ "$IMPLEMENTATION_AGENT" = "claude" ] || [ "$REVIEW_AGENT" = "claude" ]; then
        require_command claude
    fi
    if [ "$IMPLEMENTATION_AGENT" = "codex" ] || [ "$REVIEW_AGENT" = "codex" ]; then
        require_command "$CODEX_BIN"
    fi
    if [ "$IMPLEMENTATION_AGENT" = "opencode" ] || [ "$REVIEW_AGENT" = "opencode" ]; then
        require_command opencode
    fi
fi

if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${RED}Error: Looper must run inside a git repository.${NC}"
    exit 1
fi

pin_runtime_and_reexec
if [ "$MODE" != "watch" ]; then
    apply_pinned_runtime_paths
fi

if [ "$MODE" = "run" ] && [ ! -d "$STATE_DIR" ]; then
    echo -e "${RED}Error: state directory not found: $STATE_DIR${NC}"
    echo "Run looper prepare --prd PATH or looper prepare --spec PATH first."
    exit 1
fi

if [ "$MODE" = "run" ] && [ ! -f "$STORIES_FILE" ]; then
    echo -e "${RED}Error: $STORIES_FILE not found.${NC}"
    echo "Prepare and approve a source decomposition first."
    exit 1
fi
if [ "$MODE" = "run" ] && { [ ! -f "$DECOMPOSITION_STATE_FILE" ] || [ "$(jq -r '.status // empty' "$DECOMPOSITION_STATE_FILE" 2>/dev/null)" != "APPROVED" ]; }; then
    echo -e "${RED}Error: run requires an APPROVED decomposition state.${NC}"
    echo "Use looper prepare --prd PATH or looper prepare --spec PATH first."
    exit 1
fi

if [ ! -f "$IMPLEMENTATION_PROMPT_FILE" ]; then
    echo -e "${RED}Error: implementation prompt template not found at $IMPLEMENTATION_PROMPT_FILE${NC}"
    echo "Looper installation may be broken. Re-run install.sh"
    exit 1
fi

if [ ! -f "$SHARED_PROMPT_FILE" ]; then
    echo -e "${RED}Error: shared prompt template not found at $SHARED_PROMPT_FILE${NC}"
    echo "Looper installation may be broken. Re-run install.sh"
    exit 1
fi

if [ ! -f "$REVIEW_PROMPT_FILE" ]; then
    echo -e "${RED}Error: Review prompt template not found at $REVIEW_PROMPT_FILE${NC}"
    exit 1
fi

if [ ! -f "$REVIEW_SCHEMA_FILE" ]; then
    echo -e "${RED}Error: review schema not found at $REVIEW_SCHEMA_FILE${NC}"
    exit 1
fi
for required_file in "$STORIES_SCHEMA_FILE" "$PLANNER_PROMPT_FILE" "$PLAN_REVIEW_PROMPT_FILE" "$PLAN_SCHEMA_FILE" "$PLAN_REVIEW_SCHEMA_FILE" \
  "$DECOMPOSER_PROMPT_FILE" "$DECOMPOSITION_REVISER_PROMPT_FILE" "$DECOMPOSITION_REVIEW_PROMPT_FILE" \
  "$DECOMPOSITION_SCHEMA_FILE" "$DECOMPOSITION_REVISION_SCHEMA_FILE" "$DECOMPOSITION_REVIEW_SCHEMA_FILE"; do
    if [ ! -f "$required_file" ]; then
        echo -e "${RED}Error: required Looper planning asset not found at $required_file${NC}"
        exit 1
    fi
done

if [ -f "$PROMPT_SHARED_FILE" ]; then
    echo "Shared prompt addendum: $PROMPT_SHARED_FILE"
fi
if [ -f "$PROMPT_IMPLEMENTER_FILE" ]; then
    echo "Implementer prompt addendum: $PROMPT_IMPLEMENTER_FILE"
fi
if [ -f "$PROMPT_REVIEWER_FILE" ]; then
    echo "Reviewer prompt addendum: $PROMPT_REVIEWER_FILE"
fi
if [ -f "$LEGACY_LOCAL_PROMPT_FILE" ]; then
    echo -e "${YELLOW}Ignoring deprecated prompt file: $LEGACY_LOCAL_PROMPT_FILE (use prompt.shared.md or prompt.implementer.md).${NC}"
fi
if [ -f "$LEGACY_REVIEW_PROMPT_FILE" ]; then
    echo -e "${YELLOW}Ignoring deprecated prompt file: $LEGACY_REVIEW_PROMPT_FILE (use prompt.reviewer.md).${NC}"
fi

CURRENT_BRANCH="$CURRENT_GIT_BRANCH_RAW"
if [ "$MODE" = "prepare" ] || [ "$MODE" = "start" ]; then
    capture_authoritative_source
    init_run_dir
    trap on_exit EXIT
    trap on_signal INT TERM
    ACTIVE_STORY_TITLE="Source decomposition"
    if ! ensure_approved_decomposition; then
        echo -e "${YELLOW}Source decomposition did not reach approval; inspect $DECOMPOSITION_STATE_FILE.${NC}"
        exit 1
    fi
    if [ "$MODE" = "prepare" ]; then
        exit 0
    fi
    MODE="run"
fi

if [ "$MODE" = "watch" ]; then
    watch_active_run
    exit 0
fi

verify_authoritative_source
verify_approved_decomposition_chain
if [ -f "$ACTIVE_LOCK_FILE" ]; then
    jq -e . "$STORIES_FILE" >/dev/null 2>&1 || { echo -e "${RED}Error: live story list is not valid JSON.${NC}"; exit 1; }
    recover_terminal_replacements
else
    validate_story_contracts
fi

CURRENT_BRANCH="$(jq -r '.branchName // empty' "$STORIES_FILE")"
if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "null" ]; then
    CURRENT_BRANCH="$CURRENT_GIT_BRANCH_RAW"
fi
mkdir -p "$STATE_DIR"

EXPECTED_BRANCH_SLUG="$CURRENT_BRANCH"
case "$EXPECTED_BRANCH_SLUG" in codex/*|looper/*) EXPECTED_BRANCH_SLUG="${EXPECTED_BRANCH_SLUG#*/}" ;; esac
if [ "$EXPECTED_BRANCH_SLUG" != "$STATE_BRANCH_NAME" ] && [ "$CURRENT_BRANCH" != "$CURRENT_GIT_BRANCH_RAW" ]; then
    echo -e "${RED}Error: stories branch '$CURRENT_BRANCH' does not match current branch '$CURRENT_GIT_BRANCH_RAW'.${NC}"
    exit 1
fi

echo "Branch: $CURRENT_BRANCH"
echo "Progress file: $PROGRESS_FILE"

# Initialize progress file if missing
if [ ! -f "$PROGRESS_FILE" ]; then
    echo "# Looper Progress Log" > "$PROGRESS_FILE"
    echo "Branch: $CURRENT_BRANCH" >> "$PROGRESS_FILE"
    echo "Started: $(date)" >> "$PROGRESS_FILE"
    echo "---" >> "$PROGRESS_FILE"
    echo "" >> "$PROGRESS_FILE"
    echo "## Codebase Patterns" >> "$PROGRESS_FILE"
    echo "(Patterns discovered during implementation)" >> "$PROGRESS_FILE"
    echo "---" >> "$PROGRESS_FILE"
    echo "" >> "$PROGRESS_FILE"
fi

if [ -z "$RUN_DIR" ]; then
    init_run_dir
    trap on_exit EXIT
    trap on_signal INT TERM
fi

for i in $(seq 1 "$MAX_ITERATIONS"); do
    echo ""
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "${GREEN}  Looper iteration $i of $MAX_ITERATIONS${NC}"
    echo -e "${GREEN}=======================================================${NC}"
    echo ""

    INCOMPLETE="$(jq '[.stories[] | select((.passes // false) == false)] | length' "$STORIES_FILE")"
    if [ "$INCOMPLETE" -eq 0 ] && [ ! -f "$ACTIVE_LOCK_FILE" ]; then
        echo -e "${GREEN}All stories complete! Looper is done.${NC}"
        exit 0
    fi

    select_or_load_active_story

    echo "Active story: $ACTIVE_STORY_ID - $ACTIVE_STORY_TITLE"

    ensure_story_contract_lock "$ACTIVE_STORY_ID"
    if ! ensure_approved_story_plan "$ACTIVE_STORY_ID"; then
        echo -e "${RED}Looper stopped before implementation; the persisted planning state is resumable.${NC}"
        exit 1
    fi

    RESUME_PHASE="$(jq -r '.phase // empty' "$ACTIVE_LOCK_FILE")"
    if [ "$RESUME_PHASE" = "COMMIT_FAILED" ] || [ "$RESUME_PHASE" = "APPROVED_PENDING_COMMIT" ] || [ "$RESUME_PHASE" = "COMMITTING" ]; then
        echo "Resuming approved commit for $ACTIVE_STORY_ID from state $RESUME_PHASE."
        if ! stage_and_commit_story "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE"; then
            exit 1
        fi
        ensure_story_state_file "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE"
        append_story_history_entry "$ACTIVE_STORY_FILE" "Story committed and marked passed after commit resume."
        if [ "$(jq '[.stories[] | select(.passes == false and ((.execution.status // "PENDING") != "REPLACED"))] | length' "$STORIES_FILE")" -eq 0 ]; then
            echo -e "${GREEN}All stories complete! Looper is done.${NC}"
            exit 0
        fi
        continue
    fi

    ensure_story_state_file "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE"
    INITIAL_PHASE="implementation"
    INITIAL_REVIEW_ROUND=""
    if story_should_resume_remediation "$ACTIVE_STORY_FILE"; then
        INITIAL_PHASE="remediation"
        INITIAL_REVIEW_ROUND="$(story_review_round "$ACTIVE_STORY_FILE")"
        if [ -n "$INITIAL_REVIEW_ROUND" ]; then
            echo "Resuming remediation for $ACTIVE_STORY_ID after review round $INITIAL_REVIEW_ROUND."
        else
            echo "Resuming remediation for $ACTIVE_STORY_ID based on unresolved review findings."
        fi
    fi

    run_implementation_phase "$INITIAL_PHASE" "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$INITIAL_REVIEW_ROUND"

    if ! has_uncommitted_changes; then
        echo -e "${YELLOW}No uncommitted changes after $(agent_display_name "$IMPLEMENTATION_AGENT") implementation for $ACTIVE_STORY_ID; skipping review.${NC}"
        sleep 2
        continue
    fi

    APPROVED=false
    APPROVED_ROUND=0
    APPROVED_REVIEW_JSON=""

    for round in $(seq 1 "$REVIEW_MAX_ROUNDS"); do
        REVIEW_JSON_RESULT=""
        run_review_round "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$round" "$ACTIVE_STORY_FILE"
        REVIEW_JSON_FILE="$REVIEW_JSON_RESULT"
        validate_code_review_semantics "$REVIEW_JSON_FILE"
        update_story_review_state "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$REVIEW_JSON_FILE" "$round" "$(agent_display_name "$REVIEW_AGENT")"
        VERDICT="$(jq -r '.verdict // empty' "$REVIEW_JSON_FILE")"

        if [ "$VERDICT" = "APPROVED" ]; then
            echo -e "${GREEN}$(agent_display_name "$REVIEW_AGENT") review APPROVED ($ACTIVE_STORY_ID, round $round).${NC}"
            APPROVED=true
            APPROVED_ROUND="$round"
            APPROVED_REVIEW_JSON="$REVIEW_JSON_FILE"
            break
        fi

        if [ "$VERDICT" != "CHANGES_REQUESTED" ]; then
            echo -e "${RED}Error: invalid Codex verdict '$VERDICT' in $REVIEW_JSON_FILE${NC}"
            exit 1
        fi

        echo -e "${YELLOW}$(agent_display_name "$REVIEW_AGENT") requested changes ($ACTIVE_STORY_ID, round $round).${NC}"

        if [ "$round" -lt "$REVIEW_MAX_ROUNDS" ]; then
            run_implementation_phase "remediation" "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$round"
            rm -f "$REVIEW_JSON_FILE"
        fi
    done

    if [ "$APPROVED" != "true" ]; then
        record_review_limit_failure "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$REVIEW_JSON_FILE" "$REVIEW_MAX_ROUNDS" "$(agent_display_name "$REVIEW_AGENT")" "$ACTIVE_STORY_FILE"
        rm -f "$REVIEW_JSON_FILE"
        echo -e "${RED}Max review rounds reached for $ACTIVE_STORY_ID without approval from $(agent_display_name "$REVIEW_AGENT"). Stopping run for manual intervention.${NC}"
        exit 1
    fi

    record_approval_summary "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE" "$APPROVED_REVIEW_JSON" "$ACTIVE_STORY_FILE" "$APPROVED_ROUND" "$(agent_display_name "$REVIEW_AGENT")"
    rm -f "$APPROVED_REVIEW_JSON"
    set_active_phase "APPROVED_PENDING_COMMIT"
    if ! stage_and_commit_story "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE"; then
        exit 1
    fi
    ensure_story_state_file "$ACTIVE_STORY_ID" "$ACTIVE_STORY_TITLE"
    append_story_history_entry "$ACTIVE_STORY_FILE" "Story approved, committed, and marked passed."

    if [ "$(jq '[.stories[] | select(.passes == false and ((.execution.status // "PENDING") != "REPLACED"))] | length' "$STORIES_FILE")" -eq 0 ]; then
        echo -e "${GREEN}All stories complete! Looper is done.${NC}"
        exit 0
    fi

    echo "Iteration $i complete. Pausing 2 seconds..."
    sleep 2
done

echo -e "${RED}Max iterations ($MAX_ITERATIONS) reached without completion.${NC}"
echo "Check $PROGRESS_FILE and $STORIES_FILE for status."
exit 1
