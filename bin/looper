#!/usr/bin/env bash
# Looper: a small, review-gated implementation loop.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || printf '%s' "$0")"
LOOPER_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PROJECT_DIR="$PWD"

load_env() {
    local file value name
    for file in "${LOOPER_ENV_FILE:-$HOME/.config/looper/env}" "$PROJECT_DIR/.looper/env"; do
        [ -f "$file" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|'#'*) continue ;; esac
            name="${line%%=*}"
            value="${line#*=}"
            case "$name" in LOOPER_*|ANTHROPIC_API_KEY|OPENAI_API_KEY|XAI_API_KEY)
                [ -n "${!name+x}" ] || export "$name=$value"
            esac
        done < "$file"
    done
}
load_env
GLOBAL_ENV_FILE="${LOOPER_ENV_FILE:-$HOME/.config/looper/env}"

MODE="run"
SOURCE_KIND=""
SOURCE_ARG=""
WATCH_ARG=""
MAX_ITERATIONS=10
case "${1:-}" in
  prepare|start)
    MODE="$1"; shift
    case "${1:-}" in --prd) SOURCE_KIND=prd ;; --spec) SOURCE_KIND=spec ;; *) echo "Usage: looper $MODE (--prd|--spec) PATH" >&2; exit 2 ;; esac
    shift; SOURCE_ARG="${1:-}"; [ -n "$SOURCE_ARG" ] || { echo "Error: source path is required." >&2; exit 2; }; shift
    ;;
  run) shift; MAX_ITERATIONS="${1:-10}"; [ $# -eq 0 ] || shift ;;
  watch) MODE=watch; shift; WATCH_ARG="${1:-}"; [ $# -eq 0 ] || shift ;;
  --help|-h) MODE=help; shift ;;
  '') ;;
  *) MAX_ITERATIONS="$1"; shift ;;
esac
[ $# -eq 0 ] || { echo "Error: unexpected arguments: $*" >&2; exit 2; }

branch="$(git -C "$PROJECT_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || printf unknown-branch)"
slug="$branch"
case "$slug" in codex/*|looper/*) slug="${slug#*/}" ;; esac
slug="$(printf '%s' "$slug" | sed 's#[^A-Za-z0-9._-]#-#g')"
[ -n "$slug" ] || slug=unknown-branch
case "${LOOPER_STATE_DIR:-}" in
  '') STATE_DIR="$PROJECT_DIR/.looper/$slug" ;;
  /*) STATE_DIR="$LOOPER_STATE_DIR" ;;
  *) STATE_DIR="$PROJECT_DIR/$LOOPER_STATE_DIR" ;;
esac
case "$STATE_DIR" in "$PROJECT_DIR"/*) STATE_REL="${STATE_DIR#"$PROJECT_DIR"/}" ;; *) STATE_REL="" ;; esac

STATE_FILE="$STATE_DIR/state.json"
STORIES_FILE="$STATE_DIR/stories.json"
PREP_DIR="$STATE_DIR/preparation"
REVIEWS_DIR="$STATE_DIR/reviews"
LOG_DIR="$STATE_DIR/logs"
CACHE_FILE="$STATE_DIR/validation-cache.json"

PLAN_SCHEMA="$LOOPER_DIR/templates/execution-plan.schema.json"
REVIEW_SCHEMA="$LOOPER_DIR/templates/review.schema.json"
CLOSURE_SCHEMA="$LOOPER_DIR/templates/closure.schema.json"
PLANNING_PROMPT="$LOOPER_DIR/templates/prompt.planning.md"
PLAN_REVIEW_PROMPT="$LOOPER_DIR/templates/prompt.plan-review.md"
CLOSURE_PROMPT="$LOOPER_DIR/templates/prompt.closure-review.md"
IMPLEMENTER_PROMPT="$LOOPER_DIR/templates/prompt.implementer.md"
REVIEWER_PROMPT="$LOOPER_DIR/templates/prompt.reviewer.md"
SHARED_PROMPT="$LOOPER_DIR/templates/prompt.shared.md"

IMPLEMENTATION_AGENT="${LOOPER_IMPLEMENTATION_AGENT:-claude}"
REVIEW_AGENT="${LOOPER_REVIEW_AGENT:-codex}"
IMPLEMENTATION_MODEL="${LOOPER_IMPLEMENTATION_MODEL:-}"
REVIEW_MODEL="${LOOPER_REVIEW_MODEL:-}"
VALIDATION_COMMANDS="${LOOPER_VALIDATION_COMMANDS:-}"
AGENT_TIMEOUT="${LOOPER_AGENT_TIMEOUT_SECONDS:-600}"
CODEX_BIN="${CODEX_BIN:-codex}"

red=$'\033[0;31m'; green=$'\033[0;32m'; reset=$'\033[0m'
now() { date -u +'%Y-%m-%dT%H:%M:%SZ'; }
epoch() { date +%s; }
sha_file() { shasum -a 256 "$1" | awk '{print $1}'; }
sha_text() { shasum -a 256 | awk '{print $1}'; }
display_path() { case "$1" in "$PROJECT_DIR"/*) printf '%s' "${1#"$PROJECT_DIR"/}" ;; *) printf '%s' "$1" ;; esac; }
require() { command -v "$1" >/dev/null 2>&1 || { echo "Error: required command '$1' not found." >&2; exit 1; }; }
validate_agent() { case "$1" in claude|codex|opencode) ;; *) echo "Error: $2 must be claude, codex, or opencode." >&2; exit 1 ;; esac; }

usage() {
    cat <<'EOF'
Usage:
  looper prepare (--prd|--spec) PATH
  looper start (--prd|--spec) PATH
  looper run [max_iterations]
  looper [max_iterations]
  looper watch [--raw]

Configuration:
  LOOPER_IMPLEMENTATION_AGENT  claude|codex|opencode (default: claude)
  LOOPER_REVIEW_AGENT          claude|codex|opencode (default: codex)
  LOOPER_IMPLEMENTATION_MODEL  opencode implementation/planning model
  LOOPER_REVIEW_MODEL          opencode review model
  LOOPER_VALIDATION_COMMANDS   newline-separated harness commands
  LOOPER_AGENT_TIMEOUT_SECONDS per-agent timeout (default: 600)
  LOOPER_STATE_DIR             state directory override
EOF
}

atomic_jq() {
    local file="$1"; shift
    local tmp
    tmp="$(mktemp "${file}.XXXXXX")"
    jq "$@" "$file" > "$tmp" && mv "$tmp" "$file"
}

set_phase() {
    local phase="$1"
    atomic_jq "$STATE_FILE" --arg p "$phase" --arg t "$(now)" '.phase=$p | .phaseStartedAt=$t'
}

terminal() {
    local code="$1" message="$2"
    if [ -f "$STATE_FILE" ]; then
        local terminal_phase
        case "$code" in
          VALIDATION_FAILED|COMMIT_FAILED|PLAN_STALE) terminal_phase="$code" ;;
          *) if [ "$(jq -r '.activeStoryId // empty' "$STATE_FILE" 2>/dev/null)" = "" ]; then terminal_phase=PREPARATION_FAILED; else terminal_phase=NEEDS_HUMAN; fi ;;
        esac
        atomic_jq "$STATE_FILE" --arg c "$code" --arg m "$message" --arg t "$(now)" \
          --arg p "$terminal_phase" '.phase=$p | .phaseStartedAt=$t | .terminalDiagnostic={code:$c,message:$m,at:$t}'
    fi
    printf '%s%s%s\n%s\n' "$red" "$code" "$reset" "$message" >&2
    exit 1
}

init_dirs() {
    mkdir -p "$STATE_DIR" "$PREP_DIR" "$REVIEWS_DIR" "$LOG_DIR"
    [ -f "$CACHE_FILE" ] || printf '{"entries":[]}\n' > "$CACHE_FILE"
}

absolute_path() {
    local dir base
    dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd)" || return 1
    base="$(basename "$1")"
    printf '%s/%s' "$dir" "$base"
}

init_preparation() {
    local source_path source_hash
    [ -f "$SOURCE_ARG" ] || { echo "Error: authoritative source not found: $SOURCE_ARG" >&2; exit 1; }
    source_path="$(absolute_path "$SOURCE_ARG")"
    source_hash="$(sha_file "$source_path")"
    init_dirs
    if [ -e "$STATE_FILE" ]; then
        jq -e '.formatVersion == 1' "$STATE_FILE" >/dev/null 2>&1 || terminal STATE_FORMAT_UNSUPPORTED "This state belongs to a superseded Looper workflow. Delete it and prepare again."
        [ "$(jq -r '.source.path' "$STATE_FILE")" = "$source_path" ] && [ "$(jq -r '.source.kind' "$STATE_FILE")" = "$SOURCE_KIND" ] \
          || terminal SOURCE_MISMATCH "This preparation was started from a different source. Delete the state and prepare again."
        [ "$(jq -r '.source.hash' "$STATE_FILE")" = "$source_hash" ] \
          || terminal PLAN_STALE "The authoritative source changed. Delete the state and prepare again."
        return
    fi
    if [ -e "$STORIES_FILE" ] || [ "$(find "$PREP_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')" -gt 0 ]; then
        echo "STATE_FORMAT_UNSUPPORTED: state artifacts exist without a current state.json. Delete them and prepare again." >&2
        exit 1
    fi
    jq -n --arg t "$(now)" --arg kind "$SOURCE_KIND" --arg path "$source_path" --arg hash "$source_hash" \
      --arg root "$PROJECT_DIR" --arg branch "$branch" '
      {formatVersion:1,phase:"PREPARING",startedAt:$t,phaseStartedAt:$t,
       source:{kind:$kind,path:$path,hash:$hash},
       repository:{root:$root,branch:$branch},
       preparation:{calls:[],maxCalls:4,outputRepairs:0,timeouts:0,approvedAt:null},
       approvedPlanHash:null,
       activeStoryId:null,activeStoryHash:null,
       execution:{calls:[],maxCalls:4,outputRepairs:0,timeouts:0,startedAt:null,firstImplementationAt:null},
       validation:{currentCommand:null,completed:0,total:0,cacheHits:0,nextPhase:null},metrics:{validationCacheHits:0},terminalDiagnostic:null}' > "$STATE_FILE"
}

verify_current_state() {
    [ -f "$STATE_FILE" ] || { echo "Error: no prepared Looper state. Run looper prepare --prd PATH or --spec PATH." >&2; exit 1; }
    jq -e '.formatVersion == 1' "$STATE_FILE" >/dev/null 2>&1 || terminal STATE_FORMAT_UNSUPPORTED "This state belongs to a superseded Looper workflow. Delete it and prepare again."
    local path expected actual
    path="$(jq -r '.source.path // empty' "$STATE_FILE")"
    expected="$(jq -r '.source.hash // empty' "$STATE_FILE")"
    [ -f "$path" ] || terminal PLAN_STALE "The authoritative source no longer exists at $path. Prepare again."
    actual="$(sha_file "$path")"
    [ "$actual" = "$expected" ] || terminal PLAN_STALE "The authoritative source changed at $path. Prepare again."
    [ "$(jq -r '.repository.root // empty' "$STATE_FILE")" = "$PROJECT_DIR" ] || terminal PLAN_STALE "This Looper state belongs to a different repository checkout. Prepare again."
    [ "$(jq -r '.repository.branch // empty' "$STATE_FILE")" = "$branch" ] || terminal PLAN_STALE "This Looper state belongs to a different Git branch. Prepare again."
    if [ -f "$STORIES_FILE" ]; then
        [ "$(jq -r '.source.hash // empty' "$STORIES_FILE")" = "$expected" ] || terminal PLAN_STALE "stories.json does not match the authoritative source. Prepare again."
        [ "$(jq -r '.source.path // empty' "$STORIES_FILE")" = "$path" ] || terminal PLAN_STALE "stories.json points to a different authoritative source. Prepare again."
        [ "$(jq -r '.repository.root // empty' "$STORIES_FILE")" = "$PROJECT_DIR" ] || terminal PLAN_STALE "The approved plan belongs to a different repository checkout. Prepare again."
        [ "$(jq -r '.repository.branch // empty' "$STORIES_FILE")" = "$branch" ] || terminal PLAN_STALE "The approved plan belongs to branch $(jq -r '.repository.branch' "$STORIES_FILE"), not $branch. Prepare again."
        [ "$(plan_hash)" = "$(jq -r '.approvedPlanHash // empty' "$STATE_FILE")" ] || terminal PLAN_INTEGRITY "The approved story plan changed outside Looper. Prepare again."
    fi
}

worktree_snapshot() {
    local line path
    git -C "$PROJECT_DIR" status --porcelain=v1 --untracked-files=all | while IFS= read -r line; do
        path="${line:3}"
        case "$path" in .looper|.looper/*) continue ;; esac
        if [ -n "$STATE_REL" ]; then case "$path" in "$STATE_REL"|"$STATE_REL"/*) continue ;; esac; fi
        printf '%s\n' "$line"
    done
}

require_clean_start() {
    local dirty
    dirty="$(worktree_snapshot)"
    [ -z "$dirty" ] || terminal DIRTY_WORKTREE "A new story requires a clean worktree outside Looper state. Commit, stash, or remove these changes:\n$dirty"
}

begin_call() {
    local section="$1" label="$2" log="$3" count max id
    count="$(jq ".${section}.calls | length" "$STATE_FILE")"
    max="$(jq ".${section}.maxCalls" "$STATE_FILE")"
    [ "$count" -lt "$max" ] || terminal CALL_BUDGET_EXHAUSTED "$section used all $max agent calls. No further automatic calls are allowed."
    id=$((count + 1))
    atomic_jq "$STATE_FILE" --arg s "$section" --argjson id "$id" --arg label "$label" --arg log "$(display_path "$log")" --arg t "$(now)" \
      '.[$s].calls += [{id:$id,label:$label,status:"RUNNING",startedAt:$t,finishedAt:null,log:$log}] | .currentLog=$log'
    CALL_ID="$id"
}

finish_call() {
    local section="$1" id="$2" status="$3"
    atomic_jq "$STATE_FILE" --arg s "$section" --argjson id "$id" --arg status "$status" --arg t "$(now)" \
      '(.[$s].calls[] | select(.id==$id)) |= (.status=$status | .finishedAt=$t) | .currentLog=null'
}

record_call_output() {
    local section="$1" id="$2" output="$3"
    atomic_jq "$STATE_FILE" --arg s "$section" --argjson id "$id" --arg path "$(display_path "$output")" --arg hash "$(sha_file "$output")" \
      '(.[$s].calls[] | select(.id==$id)) |= (.outputPath=$path | .outputHash=$hash)'
}

run_timed() {
    local timeout="$1" log="$2"; shift 2
    local pid start status
    "$@" > "$log" 2>&1 & pid=$!; start="$(epoch)"
    while kill -0 "$pid" 2>/dev/null; do
        if [ $(( $(epoch) - start )) -ge "$timeout" ]; then
            terminate_tree "$pid"
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            printf 'Timed out after %ss.\n' "$timeout" >> "$log"
            return 124
        fi
        sleep 0.2
    done
    set +e; wait "$pid"; status=$?; set -e
    return "$status"
}

terminate_tree() {
    local pid="$1" child
    if command -v pgrep >/dev/null 2>&1; then
        for child in $(pgrep -P "$pid" 2>/dev/null || true); do terminate_tree "$child"; done
    fi
    kill "$pid" 2>/dev/null || true
}

opencode_run() {
    local prompt="$1" model="$2" mode="$3"
    set -- run --format json --dir "$PROJECT_DIR"
    [ "$mode" = writable ] && set -- "$@" --auto
    [ -n "$model" ] && set -- "$@" --model "$model"
    opencode "$@" < "$prompt"
}

extract_json() {
    local log="$1" out="$2" text
    text="$(jq -rs 'map(select((.type // "") == "text") | .part.text // "") | join("")' "$log" 2>/dev/null || cat "$log")"
    printf '%s' "$text" | awk '
      BEGIN{s=0;d=0;q=0;e=0;b=""}
      {for(i=1;i<=length($0);i++){c=substr($0,i,1);if(!s){if(c=="{"){s=1;d=1;b="{"};continue};b=b c;if(q){if(e)e=0;else if(c=="\\")e=1;else if(c=="\"")q=0}else{if(c=="\"")q=1;else if(c=="{")d++;else if(c=="}"){d--;if(d==0){print b;exit}}}}if(s)b=b"\n"}' > "$out"
    jq -e . "$out" >/dev/null 2>&1
}

structured_agent() {
    local section="$1" agent="$2" model="$3" mode="$4" schema="$5" prompt="$6" output="$7" label="$8"
    local log
    log="$LOG_DIR/$(printf '%02d' $(( $(jq ".${section}.calls|length" "$STATE_FILE") + 1 )))-${label}.log"
    local before after response status=0 schema_json stories_before="" stories_after="" state_before state_after state_backup harness_before harness_after
    before="$(git -C "$PROJECT_DIR" rev-parse HEAD)|$(worktree_snapshot)"
    [ ! -f "$STORIES_FILE" ] || stories_before="$(sha_file "$STORIES_FILE")"
    begin_call "$section" "$label" "$log"; local id="$CALL_ID"
    state_before="$(sha_file "$STATE_FILE")"; state_backup="$(mktemp "${TMPDIR:-/tmp}/looper-state.XXXXXX")"; cp "$STATE_FILE" "$state_backup"
    harness_before="$(harness_snapshot "$output")"
    rm -f "$output"
    set +e
    case "$agent" in
      codex)
        if [ "$mode" = readonly ]; then
            run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$5" && "$4" -C "$5" -a never -s read-only exec --ephemeral --json --output-schema "$2" -o "$3" - < "$1"' -- "$prompt" "$schema" "$output" "$CODEX_BIN" "$PROJECT_DIR"
        else
            run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$5" && "$4" -C "$5" -a never -s workspace-write exec --ephemeral --json --output-schema "$2" -o "$3" - < "$1"' -- "$prompt" "$schema" "$output" "$CODEX_BIN" "$PROJECT_DIR"
        fi
        status=$?
        ;;
      claude)
        response="$LOG_DIR/$(basename "$output").${label}.claude-response.json"
        schema_json="$(cat "$schema")"
        if [ "$mode" = readonly ]; then
            run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$4" && claude -p --permission-mode plan --output-format json --json-schema "$2" < "$1" > "$3"' -- "$prompt" "$schema_json" "$response" "$PROJECT_DIR"
        else
            run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$4" && claude -p --dangerously-skip-permissions --output-format json --json-schema "$2" < "$1" > "$3"' -- "$prompt" "$schema_json" "$response" "$PROJECT_DIR"
        fi
        status=$?
        [ "$status" -ne 0 ] || jq -e '.structured_output // (.result | fromjson?)' "$response" > "$output" 2>/dev/null || status=65
        ;;
      opencode)
        { printf '\n\nReturn only JSON matching this schema:\n```json\n'; cat "$schema"; printf '\n```\n'; } >> "$prompt"
        run_timed "$AGENT_TIMEOUT" "$log" opencode_run "$prompt" "$model" "$mode"; status=$?
        [ "$status" -ne 0 ] || extract_json "$log" "$output" || status=65
        ;;
    esac
    set -e
    after="$(git -C "$PROJECT_DIR" rev-parse HEAD)|$(worktree_snapshot)"
    [ ! -f "$STORIES_FILE" ] || stories_after="$(sha_file "$STORIES_FILE")"
    state_after="$(sha_file "$STATE_FILE" 2>/dev/null || printf invalid)"
    harness_after="$(harness_snapshot "$output")"
    if [ "$mode" = readonly ] && { [ "$before" != "$after" ] || [ "$stories_before" != "$stories_after" ] || [ "$state_before" != "$state_after" ] || [ "$harness_before" != "$harness_after" ]; }; then
        cp "$state_backup" "$STATE_FILE"; rm -f "$state_backup"
        finish_call "$section" "$id" MUTATED_WORKTREE
        terminal READ_ONLY_VIOLATION "$label changed the worktree. Looper will not discard those changes."
    fi
    rm -f "$state_backup"
    [ "$(sha_file "$(jq -r '.source.path' "$STATE_FILE")")" = "$(jq -r '.source.hash' "$STATE_FILE")" ] \
      || terminal PLAN_STALE "$label ran while the authoritative source changed. Prepare again."
    if [ "$status" -eq 124 ]; then
        finish_call "$section" "$id" TIMEOUT
        atomic_jq "$STATE_FILE" --arg s "$section" '.[$s].timeouts += 1'
        CALL_RESULT=timeout
        return 1
    fi
    if [ "$status" -ne 0 ] || [ ! -s "$output" ] || ! jq -e . "$output" >/dev/null 2>&1; then
        finish_call "$section" "$id" INVALID_OUTPUT
        CALL_RESULT=invalid
        return 1
    fi
    record_call_output "$section" "$id" "$output"
    finish_call "$section" "$id" COMPLETE
    CALL_RESULT=complete
    return 0
}

unstructured_agent() {
    local section="$1" agent="$2" model="$3" prompt="$4" label="$5"
    local log status=0
    log="$LOG_DIR/$(printf '%02d' $(( $(jq ".${section}.calls|length" "$STATE_FILE") + 1 )))-${label}.log"
    local head_before stories_before state_before state_backup harness_before head_after stories_after state_after harness_after
    begin_call "$section" "$label" "$log"; local id="$CALL_ID"
    head_before="$(git -C "$PROJECT_DIR" rev-parse HEAD)"
    stories_before="$(sha_file "$STORIES_FILE")"
    state_before="$(sha_file "$STATE_FILE")"
    state_backup="$(mktemp "${TMPDIR:-/tmp}/looper-state.XXXXXX")"; cp "$STATE_FILE" "$state_backup"
    harness_before="$(harness_snapshot)"
    set +e
    case "$agent" in
      codex) run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$3" && "$2" exec -s danger-full-access -C "$3" --skip-git-repo-check --ephemeral - < "$1"' -- "$prompt" "$CODEX_BIN" "$PROJECT_DIR" ; status=$? ;;
      claude) run_timed "$AGENT_TIMEOUT" "$log" bash -c 'cd "$2" && claude -p --verbose --output-format stream-json --dangerously-skip-permissions < "$1"' -- "$prompt" "$PROJECT_DIR" ; status=$? ;;
      opencode) run_timed "$AGENT_TIMEOUT" "$log" opencode_run "$prompt" "$model" writable; status=$? ;;
    esac
    set -e
    head_after="$(git -C "$PROJECT_DIR" rev-parse HEAD)"
    stories_after="$(sha_file "$STORIES_FILE")"
    state_after="$(sha_file "$STATE_FILE" 2>/dev/null || printf invalid)"
    harness_after="$(harness_snapshot)"
    if [ "$head_before" != "$head_after" ] || [ "$stories_before" != "$stories_after" ] || [ "$state_before" != "$state_after" ] || [ "$harness_before" != "$harness_after" ]; then
        cp "$state_backup" "$STATE_FILE"; rm -f "$state_backup"
        finish_call "$section" "$id" VIOLATED_BOUNDARY 2>/dev/null || true
        terminal AGENT_BOUNDARY_VIOLATION "$label changed a locked Looper artifact or created a commit. Looper will not continue or discard the changes."
    fi
    rm -f "$state_backup"
    if [ "$status" -eq 0 ]; then finish_call "$section" "$id" COMPLETE; return 0; fi
    [ "$status" -ne 124 ] || atomic_jq "$STATE_FILE" --arg s "$section" '.[$s].timeouts += 1'
    finish_call "$section" "$id" FAILED
    terminal AGENT_FAILED "$label failed (exit $status). See $(display_path "$log")."
}

harness_snapshot() {
    local excluded="${1:-}" root file
    for root in "$PREP_DIR" "$REVIEWS_DIR"; do
        [ -d "$root" ] || continue
        find "$root" -type f | LC_ALL=C sort | while IFS= read -r file; do
            [ "$file" = "$excluded" ] || sha_file "$file"
        done
    done
    [ ! -f "$CACHE_FILE" ] || [ "$CACHE_FILE" = "$excluded" ] || sha_file "$CACHE_FILE"
    for file in "$STATE_DIR/prompt.shared.md" "$STATE_DIR/prompt.implementer.md" "$STATE_DIR/prompt.reviewer.md" \
      "$PROJECT_DIR/.looper/env" "$GLOBAL_ENV_FILE"; do
        [ ! -f "$file" ] || [ "$file" = "$excluded" ] || sha_file "$file"
    done
}

valid_plan() {
    local file="$1"
    jq -e '
      (.project|type=="string" and length>0) and (.description|type=="string") and
      (.sourceItems|type=="array" and length>0) and (.stories|type=="array" and length>0) and
      ([.sourceItems[].id]|length == (unique|length)) and ([.stories[].id]|length == (unique|length)) and
      ([.stories[].acceptanceCriteria[].id]|length == (unique|length)) and
      all(.sourceItems[]; (.id|type=="string" and length>0) and (.kind|IN("requirement","constraint","non_goal")) and (.text|type=="string" and length>0)) and
      all(.stories[]; (.id|type=="string" and length>0) and (.title|type=="string" and length>0) and
        (.outcome|type=="string" and length>0) and (.sourceRefs|type=="array" and length>0) and
        (.scope|type=="array") and (.nonGoals|type=="array") and (.acceptanceCriteria|type=="array" and length>0) and
        (.dependsOn|type=="array") and (.likelyFiles|type=="array") and (.steps|type=="array" and length>0) and
        (.architectureNotes|type=="array") and (.risks|type=="array") and (.assumptions|type=="array") and
        (.disappointmentCheck|type=="string" and length>0) and
        all(.acceptanceCriteria[]; (.id|type=="string" and length>0) and (.behavior|type=="string" and length>0) and
          (.proof|type=="string" and length>0) and (.commands|type=="array")))
    ' "$file" >/dev/null 2>&1 || return 1
    jq -e '
      . as $plan | ([.sourceItems[].id] as $sources |
        all(.stories[].sourceRefs[]; . as $ref | any($sources[]; . == $ref)) and
        all($sources[]; . as $source | any($plan.stories[]; .sourceRefs | index($source)))) and
      (reduce .stories[] as $s ({seen:[],ok:true}; .seen as $seen |
        .ok = (.ok and all($s.dependsOn[]; . as $dep | any($seen[]; . == $dep))) | .seen += [$s.id]) | .ok)
    ' "$file" >/dev/null 2>&1
}

valid_review() {
    local file="$1" plan="$2" expected actual
    jq -e '
      (.verdict|IN("APPROVED","CHANGES_REQUESTED")) and (.summary|type=="string" and length>0) and
      (.findings|type=="array") and ([.findings[].id]|length==(unique|length)) and
      all(.findings[]; (.id|type=="string" and length>0) and (.priority|IN("P0","P1","P2","P3")) and
        (.axis|type=="string" and length>0) and (.details|type=="string" and length>0) and (.evidence|type=="string" and length>0)) and
      (.itemResults|type=="array") and ([.itemResults[].id]|length==(unique|length)) and
      all(.itemResults[]; (.id|type=="string" and length>0) and (.status|IN("pass","fail")) and (.details|type=="string" and length>0)) and
      (if .verdict=="APPROVED" then (.findings|length)==0 and all(.itemResults[];.status=="pass") else (.findings|length)>0 end)
    ' "$file" >/dev/null 2>&1 || return 1
    expected="$(jq -c '[.sourceItems[].id,.stories[].id]|sort' "$plan")"
    actual="$(jq -c '[.itemResults[].id]|sort' "$file")"
    [ "$expected" = "$actual" ]
}

valid_code_review() {
    local file="$1" story="$2" expected actual
    jq -e '
      (.verdict|IN("APPROVED","CHANGES_REQUESTED")) and (.summary|type=="string" and length>0) and
      (.findings|type=="array") and ([.findings[].id]|length==(unique|length)) and
      all(.findings[]; (.id|type=="string" and length>0) and (.priority|IN("P0","P1","P2","P3")) and
        (.axis|IN("standards","spec")) and (.details|type=="string" and length>0) and (.evidence|type=="string" and length>0)) and
      (.itemResults|type=="array") and ([.itemResults[].id]|length==(unique|length)) and
      all(.itemResults[]; (.status|IN("pass","fail")) and (.details|type=="string" and length>0)) and
      (if .verdict=="APPROVED" then (.findings|length)==0 and all(.itemResults[];.status=="pass") else (.findings|length)>0 end)
    ' "$file" >/dev/null 2>&1 || return 1
    expected="$(jq -c '[.acceptanceCriteria[].id]|sort' <<< "$story")"
    actual="$(jq -c '[.itemResults[].id]|sort' "$file")"
    [ "$expected" = "$actual" ]
}

valid_closure() {
    local file="$1" review="$2" expected actual
    jq -e '
      (.verdict|IN("APPROVED","REJECTED")) and (.summary|type=="string" and length>0) and
      (.findingResolutions|type=="array") and ([.findingResolutions[].findingId]|length==(unique|length)) and
      all(.findingResolutions[]; (.findingId|type=="string" and length>0) and (.status|IN("resolved","unresolved")) and (.evidence|type=="string" and length>0)) and
      (.regressions|type=="array") and all(.regressions[]; (.id|type=="string" and length>0) and (.causedByFindingId|type=="string" and length>0) and (.details|type=="string" and length>0) and (.evidence|type=="string" and length>0)) and
      (if .verdict=="APPROVED" then all(.findingResolutions[];.status=="resolved") and (.regressions|length)==0 else (any(.findingResolutions[];.status=="unresolved") or (.regressions|length)>0) end)
    ' "$file" >/dev/null 2>&1 || return 1
    expected="$(jq -c '[.findings[].id]|sort' "$review")"
    actual="$(jq -c '[.findingResolutions[].findingId]|sort' "$file")"
    [ "$expected" = "$actual" ] && jq -e --argjson ids "$expected" 'all(.regressions[]; .causedByFindingId as $id | any($ids[]; . == $id))' "$file" >/dev/null
}

prompt_header() {
    cat "$SHARED_PROMPT"
    [ ! -f "$STATE_DIR/prompt.shared.md" ] || cat "$STATE_DIR/prompt.shared.md"
}

build_plan_prompt() {
    local base="$1" prior="${2:-}"
    prompt_header; cat "$PLANNING_PROMPT"
    printf '\n## Runtime context\n- Repository root: %s\n- Source kind: %s\n- Source path: %s\n- Source hash: %s\n\n## Authoritative source\n' \
      "$PROJECT_DIR" "$(jq -r '.source.kind' "$STATE_FILE")" "$(jq -r '.source.path' "$STATE_FILE")" "$(jq -r '.source.hash' "$STATE_FILE")"
    cat "$(jq -r '.source.path' "$STATE_FILE")"
    if [ -n "$base" ]; then
        printf '\n\n## Plan to revise\n```json\n'; cat "$base"; printf '\n```\n## Findings to resolve\n```json\n'; cat "$prior"; printf '\n```\nReturn the complete revised plan.\n'
    fi
}

build_plan_review_prompt() {
    local plan="$1"
    prompt_header; cat "$PLAN_REVIEW_PROMPT"
    printf '\n## Authoritative source\n'; cat "$(jq -r '.source.path' "$STATE_FILE")"
    printf '\n\n## Complete proposed plan\n```json\n'; cat "$plan"; printf '\n```\n'
}

build_closure_prompt() {
    local original="$1" revised="$2" subject="$3"
    prompt_header; cat "$CLOSURE_PROMPT"
    printf '\n## Closure subject\n%s\n\n## Original findings\n```json\n' "$subject"; cat "$original"
    printf '\n```\n## Revised evidence\n```json\n'; cat "$revised"; printf '\n```\n'
}

build_plan_closure_prompt() {
    local original="$1" review="$2" revised="$3"
    prompt_header; cat "$CLOSURE_PROMPT"
    printf '\n## Closure subject\nexecution plan\n\n## Authoritative source\n'; cat "$(jq -r '.source.path' "$STATE_FILE")"
    printf '\n\n## Original proposed plan\n```json\n'; cat "$original"
    printf '\n```\n## Original broad-review findings\n```json\n'; cat "$review"
    printf '\n```\n## Complete revised plan\n```json\n'; cat "$revised"; printf '\n```\n'
}

call_with_one_repair() {
    local section="$1" agent="$2" model="$3" schema="$4" prompt="$5" output="$6" label="$7" validator="$8" context="$9" reserve="${10:-0}"
    if artifact_proven "$section" "$label" "$output" "$validator" "$context"; then return 0; fi
    rm -f "$output"
    local failed_kind=""
    if ! structured_agent "$section" "$agent" "$model" readonly "$schema" "$prompt" "$output" "$label"; then
        failed_kind="$CALL_RESULT"
    elif ! "$validator" "$output" "$context"; then
        failed_kind=invalid
    fi
    if [ -n "$failed_kind" ]; then
        local used max repair_prompt
        if [ "$failed_kind" = timeout ]; then
            [ "$(jq ".${section}.timeouts" "$STATE_FILE")" -le 1 ] || terminal CALL_BUDGET_EXHAUSTED "$label timed out after the one allowed timeout retry was already used."
        else
            [ "$(jq ".${section}.outputRepairs" "$STATE_FILE")" -lt 1 ] || terminal CALL_BUDGET_EXHAUSTED "$label returned invalid output after the one allowed output repair was already used."
        fi
        used="$(jq ".${section}.calls|length" "$STATE_FILE")"; max="$(jq ".${section}.maxCalls" "$STATE_FILE")"
        if [ $((used + 1 + reserve)) -gt "$max" ]; then
            terminal CALL_BUDGET_EXHAUSTED "$label failed, and a repair plus the required remaining review cannot fit in the $max-call budget."
        fi
        repair_prompt="$LOG_DIR/${label}-repair.prompt.md"
        { cat "$prompt"; printf '\n\nYour previous call failed or returned invalid structured output. Return one valid JSON object matching the required schema. Do not expand scope.\n'; } > "$repair_prompt"
        [ "$failed_kind" = timeout ] || atomic_jq "$STATE_FILE" --arg s "$section" '.[$s].outputRepairs += 1'
        structured_agent "$section" "$agent" "$model" readonly "$schema" "$repair_prompt" "$output" "${label}-repair" \
          || terminal INVALID_AGENT_OUTPUT "$label did not produce valid output after one repair."
        "$validator" "$output" "$context" || terminal INVALID_AGENT_OUTPUT "$label repair violated semantic invariants."
    fi
}

artifact_proven() {
    local section="$1" label="$2" output="$3" validator="$4" context="$5" id hash
    [ -s "$output" ] && "$validator" "$output" "$context" || return 1
    hash="$(sha_file "$output")"
    if jq -e --arg section "$section" --arg label "$label" --arg hash "$hash" \
      '.[$section].calls[] | select((.label==$label or .label==($label+"-repair")) and .status=="COMPLETE" and .outputHash==$hash)' "$STATE_FILE" >/dev/null 2>&1; then
        return 0
    fi
    id="$(jq -r --arg section "$section" --arg label "$label" \
      '[.[$section].calls[] | select((.label==$label or .label==($label+"-repair")) and .status=="RUNNING")][-1].id // empty' "$STATE_FILE")"
    [ -n "$id" ] || return 1
    record_call_output "$section" "$id" "$output"
    finish_call "$section" "$id" COMPLETE
}

publish_plan() {
    local approved="$1" planning_id revision_id broad_review_id closure_id tmp
    planning_id="$(jq '[.preparation.calls[]|select(.label=="planning" or .label=="planning-repair")][-1].id' "$STATE_FILE")"
    revision_id="$(jq '[.preparation.calls[]|select(.label=="revision")][-1].id // null' "$STATE_FILE")"
    broad_review_id="$(jq '[.preparation.calls[]|select(.label=="plan-review" or .label=="plan-review-repair")][-1].id' "$STATE_FILE")"
    closure_id="$(jq '[.preparation.calls[]|select(.label=="closure-review")][-1].id // null' "$STATE_FILE")"
    tmp="$(mktemp "$STATE_DIR/stories.XXXXXX")"
    jq --arg kind "$(jq -r '.source.kind' "$STATE_FILE")" --arg path "$(jq -r '.source.path' "$STATE_FILE")" \
      --arg hash "$(jq -r '.source.hash' "$STATE_FILE")" --arg branch "$branch" --arg t "$(now)" \
      --argjson planning "$planning_id" --argjson revision "$revision_id" --argjson broadReview "$broad_review_id" --argjson closure "$closure_id" \
      --arg root "$PROJECT_DIR" --arg planningAgent "$IMPLEMENTATION_AGENT" --arg planningModel "$IMPLEMENTATION_MODEL" \
      --arg reviewAgent "$REVIEW_AGENT" --arg reviewModel "$REVIEW_MODEL" '
      {formatVersion:1,project,description,branchName:$branch,
       repository:{root:$root,branch:$branch},source:{kind:$kind,path:$path,hash:$hash},
       provenance:{approvedAt:$t,
         planning:{agent:$planningAgent,model:$planningModel,proposalCallId:$planning,revisionCallId:$revision},
         review:{agent:$reviewAgent,model:$reviewModel,broadCallId:$broadReview,closureCallId:$closure}},
       sourceItems,stories:[.stories[] + {passes:false}]} |
       .derived={coverage:[.sourceItems[] as $source | {sourceId:$source.id,storyIds:[.stories[]|select(.sourceRefs|index($source.id))|.id]}]}' "$approved" > "$tmp"
    mv "$tmp" "$STORIES_FILE"
    atomic_jq "$STATE_FILE" --arg t "$(now)" --arg hash "$(plan_hash)" '.phase="READY" | .phaseStartedAt=$t | .preparation.approvedAt=$t | .approvedPlanHash=$hash | .terminalDiagnostic=null'
    printf '%sPreparation READY:%s %s\n' "$green" "$reset" "$(display_path "$STORIES_FILE")"
}

prepare() {
    init_preparation
    verify_current_state
    [ "$(jq -r '.phase' "$STATE_FILE")" != READY ] || { echo "Preparation already READY: $(display_path "$STORIES_FILE")"; return; }
    case "$(jq -r '.phase' "$STATE_FILE")" in PREPARATION_FAILED|NEEDS_HUMAN)
        terminal "$(jq -r '.terminalDiagnostic.code' "$STATE_FILE")" "$(jq -r '.terminalDiagnostic.message' "$STATE_FILE")" ;; esac

    local proposal="$PREP_DIR/proposal.json" review="$PREP_DIR/review.json" revision="$PREP_DIR/revision.json" closure="$PREP_DIR/closure.json" prompt verdict used
    set_phase PREPARING; prompt="$LOG_DIR/planning.prompt.md"; build_plan_prompt "" > "$prompt"
    call_with_one_repair preparation "$IMPLEMENTATION_AGENT" "$IMPLEMENTATION_MODEL" "$PLAN_SCHEMA" "$prompt" "$proposal" planning valid_plan "$proposal" 1
    set_phase REVIEWING; prompt="$LOG_DIR/plan-review.prompt.md"; build_plan_review_prompt "$proposal" > "$prompt"
    call_with_one_repair preparation "$REVIEW_AGENT" "$REVIEW_MODEL" "$REVIEW_SCHEMA" "$prompt" "$review" plan-review valid_review "$proposal" 0
    verdict="$(jq -r '.verdict' "$review")"
    if [ "$verdict" = APPROVED ]; then publish_plan "$proposal"; return; fi

    used="$(jq '.preparation.calls|length' "$STATE_FILE")"
    [ $((4 - used)) -ge 2 ] || terminal CALL_BUDGET_EXHAUSTED "Preparation used $used of 4 calls. Revision requires two remaining calls: focused revision and closure review. No revision was attempted."
    if ! artifact_proven preparation revision "$revision" valid_plan "$revision"; then
        rm -f "$revision"
        set_phase REVISING; prompt="$LOG_DIR/revision.prompt.md"; build_plan_prompt "$proposal" "$review" > "$prompt"
        # No repair is possible here: closure owns the final remaining call.
        structured_agent preparation "$IMPLEMENTATION_AGENT" "$IMPLEMENTATION_MODEL" readonly "$PLAN_SCHEMA" "$prompt" "$revision" revision \
          || terminal CALL_BUDGET_EXHAUSTED "The focused revision failed and consumed its call. The remaining call is reserved for closure, so preparation stopped."
        valid_plan "$revision" || terminal INVALID_AGENT_OUTPUT "The focused revision was not a valid complete plan; no unreviewed plan was published."
    fi
    if ! artifact_proven preparation closure-review "$closure" valid_closure "$review"; then
        rm -f "$closure"
        set_phase CLOSURE_REVIEW; prompt="$LOG_DIR/closure-review.prompt.md"; build_plan_closure_prompt "$proposal" "$review" "$revision" > "$prompt"
        structured_agent preparation "$REVIEW_AGENT" "$REVIEW_MODEL" readonly "$CLOSURE_SCHEMA" "$prompt" "$closure" closure-review \
          || terminal CALL_BUDGET_EXHAUSTED "Closure review failed on the final allowed preparation call."
        valid_closure "$closure" "$review" || terminal INVALID_AGENT_OUTPUT "Closure review violated the focused finding-ID contract."
    fi
    [ "$(jq -r '.verdict' "$closure")" = APPROVED ] || terminal CLOSURE_REJECTED "Plan closure left a material finding unresolved. Inspect $(display_path "$closure"). Prepare again or intervene manually."
    publish_plan "$revision"
}

story_material() { jq -cS 'del(.passes)' <<< "$1"; }
story_hash() { story_material "$1" | sha_text; }
plan_hash() { jq -cS '{project,description,sourceItems,stories:[.stories[]|del(.passes)]}' "$STORIES_FILE" | sha_text; }

lock_story() {
    local story id hash
    if [ "$(jq -r '.activeStoryId // empty' "$STATE_FILE")" != "" ]; then return; fi
    require_clean_start
    story="$(jq -c '
      [.stories[] | select((.passes // false)==false) as $s |
        select(all($s.dependsOn[]; . as $d | any($ARGS.named.all[]; .id==$d and .passes==true))) | $s][0] // empty
      ' --argjson all "$(jq '.stories' "$STORIES_FILE")" "$STORIES_FILE")"
    [ -n "$story" ] || {
        if [ "$(jq '[.stories[]|select((.passes//false)==false)]|length' "$STORIES_FILE")" -eq 0 ]; then echo "All stories complete."; return 2; fi
        terminal DEPENDENCY_BLOCKED "No incomplete story has all dependencies complete."
    }
    id="$(jq -r '.id' <<< "$story")"; hash="$(story_hash "$story")"
    atomic_jq "$STATE_FILE" --arg id "$id" --arg hash "$hash" --arg t "$(now)" \
      '.phase="IMPLEMENTING" | .phaseStartedAt=$t | .activeStoryId=$id | .activeStoryHash=$hash |
       .execution={calls:[],maxCalls:4,outputRepairs:0,timeouts:0,startedAt:$t,firstImplementationAt:(.execution.firstImplementationAt // $t)} |
       .validation={currentCommand:null,completed:0,total:0,cacheHits:0,nextPhase:null} | .terminalDiagnostic=null'
    echo "Active story: $id - $(jq -r '.title' <<< "$story")"
}

active_story() { jq -c --arg id "$(jq -r '.activeStoryId' "$STATE_FILE")" '.stories[]|select(.id==$id)' "$STORIES_FILE"; }

verify_story_lock() {
    local story hash expected
    story="$(active_story)"; [ -n "$story" ] || terminal STORY_LOCK_INVALID "The active story is missing from stories.json."
    hash="$(story_hash "$story")"; expected="$(jq -r '.activeStoryHash' "$STATE_FILE")"
    [ "$hash" = "$expected" ] || terminal STORY_LOCK_INVALID "The active story contract changed during implementation."
    [ "$(sha_file "$(jq -r '.source.path' "$STATE_FILE")")" = "$(jq -r '.source.hash' "$STATE_FILE")" ] \
      || terminal PLAN_STALE "The authoritative source changed during story execution. Prepare again."
}

build_implementation_prompt() {
    local phase="$1" story="$2" review="${3:-}"
    prompt_header; cat "$IMPLEMENTER_PROMPT"
    [ ! -f "$STATE_DIR/prompt.implementer.md" ] || cat "$STATE_DIR/prompt.implementer.md"
    printf '\n## Runtime context\n- Phase: %s\n- Repository root: %s\n- Active story: %s\n\n## Approved story plan\n```json\n%s\n```\n' "$phase" "$PROJECT_DIR" "$(jq -r '.id' <<< "$story")" "$story"
    if [ -n "$review" ]; then printf '\n## Findings to remediate\n```json\n'; cat "$review"; printf '\n```\n'; fi
}

tree_hash() {
    local index
    index="$(mktemp "${TMPDIR:-/tmp}/looper-index.XXXXXX")"; rm -f "$index"
    if git -C "$PROJECT_DIR" rev-parse --verify HEAD >/dev/null 2>&1; then GIT_INDEX_FILE="$index" git -C "$PROJECT_DIR" read-tree HEAD; else GIT_INDEX_FILE="$index" git -C "$PROJECT_DIR" read-tree --empty; fi
    if [ -n "$STATE_REL" ]; then
        GIT_INDEX_FILE="$index" git -c advice.addIgnoredFile=false -C "$PROJECT_DIR" add -A -- . ':(exclude).looper/**' ":(exclude)$STATE_REL/**"
    else
        GIT_INDEX_FILE="$index" git -c advice.addIgnoredFile=false -C "$PROJECT_DIR" add -A -- . ':(exclude).looper/**'
    fi
    GIT_INDEX_FILE="$index" git -C "$PROJECT_DIR" write-tree
    rm -f "$index"
}

validation_commands() {
    { [ -z "$VALIDATION_COMMANDS" ] || printf '%s\n' "$VALIDATION_COMMANDS"; active_story | jq -r '.acceptanceCriteria[].commands[]?'; } | awk 'NF&&!seen[$0]++'
}

run_validation() {
    local story_id tree tree_after command key log status total=0 completed=0 hits=0 failed=0 result_file
    result_file="$REVIEWS_DIR/$(jq -r '.activeStoryId' "$STATE_FILE")-validation.json"
    story_id="$(jq -r '.activeStoryId' "$STATE_FILE")"
    while IFS= read -r command || [ -n "$command" ]; do [ -z "$command" ] || total=$((total+1)); done < <(validation_commands)
    atomic_jq "$STATE_FILE" --argjson total "$total" '.validation={currentCommand:null,completed:0,total:$total,cacheHits:0,nextPhase:(.validation.nextPhase // "VALIDATED")}'
    printf '[]\n' > "$result_file"
    while IFS= read -r command || [ -n "$command" ]; do
        [ -n "$command" ] || continue
        tree="$(tree_hash)"
        key="$(printf '%s\n%s' "$tree" "$command" | sha_text)"
        if jq -e --arg key "$key" '.entries[]|select(.key==$key and .status=="pass")' "$CACHE_FILE" >/dev/null 2>&1; then
            hits=$((hits+1)); completed=$((completed+1))
            atomic_jq "$result_file" --arg c "$command" --arg tree "$tree" '. += [{command:$c,treeHash:$tree,status:"pass",cacheHit:true,log:null}]'
            atomic_jq "$STATE_FILE" --argjson completed "$completed" --argjson hits "$hits" '.validation.completed=$completed | .validation.cacheHits=$hits | .metrics.validationCacheHits += 1'
            continue
        fi
        log="$LOG_DIR/${story_id}-validation-$((completed+1)).log"
        atomic_jq "$STATE_FILE" --arg c "$command" '.validation.currentCommand=$c'
        echo "Validating: $command"
        if (cd "$PROJECT_DIR" && bash -lc "$command") > "$log" 2>&1; then status=pass; else status=fail; failed=1; fi
        tree_after="$(tree_hash)"
        [ "$tree_after" = "$tree" ] || terminal VALIDATION_MUTATED_TREE "Validation command changed the Git tree: $command"
        if [ "$status" = pass ]; then
            atomic_jq "$CACHE_FILE" --arg key "$key" --arg tree "$tree" --arg c "$command" --arg log "$(display_path "$log")" --arg t "$(now)" \
              '.entries = ([.entries[]|select(.key!=$key)] + [{key:$key,treeHash:$tree,command:$c,status:"pass",log:$log,at:$t}])'
        fi
        completed=$((completed+1))
        atomic_jq "$result_file" --arg c "$command" --arg tree "$tree" --arg s "$status" --arg log "$(display_path "$log")" \
          '. += [{command:$c,treeHash:$tree,status:$s,cacheHit:false,log:$log}]'
        atomic_jq "$STATE_FILE" --argjson completed "$completed" '.validation.completed=$completed | .validation.currentCommand=null'
        [ "$failed" -eq 0 ] || break
    done < <(validation_commands)
    [ "$failed" -eq 0 ] || terminal VALIDATION_FAILED "Harness validation failed before review. Inspect $(display_path "$result_file"). Fix the worktree and rerun Looper to validate again."
}

begin_validation() {
    local next_phase="$1"
    atomic_jq "$STATE_FILE" --arg next "$next_phase" --arg t "$(now)" '.phase="VALIDATING" | .phaseStartedAt=$t | .validation.nextPhase=$next'
}

finish_validation() {
    set_phase "$(jq -r '.validation.nextPhase' "$STATE_FILE")"
}

build_code_review_prompt() {
    local story="$1" validation="$2" broad="${3:-}"
    prompt_header; cat "$REVIEWER_PROMPT"
    [ ! -f "$STATE_DIR/prompt.reviewer.md" ] || cat "$STATE_DIR/prompt.reviewer.md"
    printf '\n## Runtime context\n- Repository root: %s\n- Active story: %s\n\n## Approved story plan\n```json\n%s\n```\n## Harness validation evidence\n```json\n' "$PROJECT_DIR" "$(jq -r '.id' <<< "$story")" "$story"
    cat "$validation"; printf '\n```\nReview the actual uncommitted diff and return one itemResult for every acceptance-criterion ID.\n'
    [ -z "$broad" ] || { printf '\n## Original broad review (closure scope only)\n```json\n'; cat "$broad"; printf '\n```\n'; }
}

stage_commit() {
    local id title tmp
    id="$(jq -r '.activeStoryId' "$STATE_FILE")"; title="$(active_story | jq -r '.title')"
    set_phase APPROVED_PENDING_COMMIT
    if [ -n "$STATE_REL" ]; then
        git -c advice.addIgnoredFile=false -C "$PROJECT_DIR" add -A -- . ':(exclude).looper/**' ":(exclude)$STATE_REL/**"
    else
        git -c advice.addIgnoredFile=false -C "$PROJECT_DIR" add -A -- . ':(exclude).looper/**'
    fi
    if ! git -C "$PROJECT_DIR" diff --cached --quiet; then
        if ! git -C "$PROJECT_DIR" commit -m "feat: $id - $title"; then set_phase COMMIT_FAILED; terminal COMMIT_FAILED "Approval is preserved, but git commit failed. Fix Git and rerun Looper."; fi
    fi
    tmp="$(mktemp "$STATE_DIR/stories.XXXXXX")"
    jq --arg id "$id" '(.stories[]|select(.id==$id)).passes=true' "$STORIES_FILE" > "$tmp" && mv "$tmp" "$STORIES_FILE"
    atomic_jq "$STATE_FILE" --arg t "$(now)" '.phase="READY" | .phaseStartedAt=$t | .activeStoryId=null | .activeStoryHash=null | .execution.calls=[] | .validation={currentCommand:null,completed:0,total:0,cacheHits:0,nextPhase:null}'
    printf '%sCompleted:%s %s\n' "$green" "$reset" "$id"
}

execute_story() {
    lock_story || return $?
    verify_story_lock
    local story id phase prompt review closure validation
    story="$(active_story)"; id="$(jq -r '.id' <<< "$story")"; phase="$(jq -r '.phase' "$STATE_FILE")"
    review="$REVIEWS_DIR/${id}-review.json"; closure="$REVIEWS_DIR/${id}-closure.json"; validation="$REVIEWS_DIR/${id}-validation.json"
    case "$phase" in
      APPROVED_PENDING_COMMIT|COMMIT_FAILED) stage_commit; return ;;
      VALIDATING) run_validation; finish_validation; phase="$(jq -r '.phase' "$STATE_FILE")" ;;
      VALIDATION_FAILED) set_phase VALIDATING; run_validation; finish_validation; phase="$(jq -r '.phase' "$STATE_FILE")" ;;
    esac
    if [ "$phase" = IMPLEMENTING ]; then
        prompt="$LOG_DIR/${id}-implementation.prompt.md"; build_implementation_prompt implementation "$story" > "$prompt"
        if ! jq -e '.execution.calls[]|select(.label=="implementation" and .status=="COMPLETE")' "$STATE_FILE" >/dev/null 2>&1; then
            unstructured_agent execution "$IMPLEMENTATION_AGENT" "$IMPLEMENTATION_MODEL" "$prompt" implementation
        fi
        verify_story_lock
        begin_validation VALIDATED; run_validation; finish_validation; phase=VALIDATED
    fi
    if [ "$phase" = VALIDATED ] || [ "$phase" = CODE_REVIEW ]; then
        set_phase CODE_REVIEW
        prompt="$LOG_DIR/${id}-review.prompt.md"; build_code_review_prompt "$story" "$validation" > "$prompt"
        call_with_one_repair execution "$REVIEW_AGENT" "$REVIEW_MODEL" "$REVIEW_SCHEMA" "$prompt" "$review" code-review valid_code_review "$story" 0
        phase="$( [ "$(jq -r '.verdict' "$review")" = APPROVED ] && printf APPROVED || printf CHANGES_REQUESTED )"
        if [ "$phase" = APPROVED ]; then stage_commit; return; fi
        local used; used="$(jq '.execution.calls|length' "$STATE_FILE")"
        [ $((4-used)) -ge 2 ] || terminal CALL_BUDGET_EXHAUSTED "Story $id used $used of 4 calls. Remediation requires two remaining calls, so none was attempted."
        set_phase REMEDIATING
    fi
    if [ "$(jq -r '.phase' "$STATE_FILE")" = REMEDIATING ]; then
        prompt="$LOG_DIR/${id}-remediation.prompt.md"; build_implementation_prompt remediation "$story" "$review" > "$prompt"
        if ! jq -e '.execution.calls[]|select(.label=="remediation" and .status=="COMPLETE")' "$STATE_FILE" >/dev/null 2>&1; then
            unstructured_agent execution "$IMPLEMENTATION_AGENT" "$IMPLEMENTATION_MODEL" "$prompt" remediation
        fi
        verify_story_lock
        begin_validation CLOSURE_REVIEW; run_validation; finish_validation
    fi
    if [ "$(jq -r '.phase' "$STATE_FILE")" = CLOSURE_REVIEW ]; then
        prompt="$LOG_DIR/${id}-closure.prompt.md"
        build_closure_prompt "$review" <(printf '{"story":%s,"validation":' "$story"; cat "$validation"; printf ',"diff":"Inspect the current repository diff"}') "code remediation for $id" > "$prompt"
        if ! artifact_proven execution code-closure "$closure" valid_closure "$review"; then
            rm -f "$closure"
            structured_agent execution "$REVIEW_AGENT" "$REVIEW_MODEL" readonly "$CLOSURE_SCHEMA" "$prompt" "$closure" code-closure \
              || terminal CALL_BUDGET_EXHAUSTED "Code closure failed on the final allowed call for $id."
            valid_closure "$closure" "$review" || terminal INVALID_AGENT_OUTPUT "Code closure violated the focused finding-ID contract."
        fi
        [ "$(jq -r '.verdict' "$closure")" = APPROVED ] || terminal CLOSURE_REJECTED "Code closure left a material finding unresolved. Inspect $(display_path "$closure")."
        stage_commit
    fi
}

watch() {
    [ -f "$STATE_FILE" ] || { echo "No Looper state at $STATE_DIR"; exit 1; }
    local raw=0; [ "${1:-}" != --raw ] || raw=1
    if [ "$raw" -eq 1 ]; then
        local log; log="$(jq -r '.currentLog // empty' "$STATE_FILE")"; [ -n "$log" ] || { echo "No active agent log."; exit 0; }
        case "$log" in /*) tail -f "$log" ;; *) tail -f "$PROJECT_DIR/$log" ;; esac
        return
    fi
    local started elapsed calls max story total complete phase validation hits repairs timeouts current approved first time_plan time_first disposition
    started="$(jq -r '.startedAt' "$STATE_FILE")"; elapsed=$(( $(epoch) - $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$started" +%s 2>/dev/null || date -d "$started" +%s) ))
    phase="$(jq -r '.phase' "$STATE_FILE")"; story="$(jq -r '.activeStoryId // "-"' "$STATE_FILE")"
    if [ "$story" = - ]; then calls="$(jq '.preparation.calls|length' "$STATE_FILE")"; max="$(jq '.preparation.maxCalls' "$STATE_FILE")"; else calls="$(jq '.execution.calls|length' "$STATE_FILE")"; max="$(jq '.execution.maxCalls' "$STATE_FILE")"; fi
    if [ "$story" = - ]; then repairs="$(jq '.preparation.outputRepairs' "$STATE_FILE")"; timeouts="$(jq '.preparation.timeouts' "$STATE_FILE")"; else repairs="$(jq '.execution.outputRepairs' "$STATE_FILE")"; timeouts="$(jq '.execution.timeouts' "$STATE_FILE")"; fi
    if [ -f "$STORIES_FILE" ]; then total="$(jq '.stories|length' "$STORIES_FILE")"; complete="$(jq '[.stories[]|select(.passes==true)]|length' "$STORIES_FILE")"; else total=0; complete=0; fi
    validation="$(jq -r '"\(.validation.completed)/\(.validation.total)"' "$STATE_FILE")"; hits="$(jq '.metrics.validationCacheHits // .validation.cacheHits' "$STATE_FILE")"; current="$(jq -r '.validation.currentCommand // "-"' "$STATE_FILE")"
    approved="$(jq -r '.preparation.approvedAt // empty' "$STATE_FILE")"; first="$(jq -r '.execution.firstImplementationAt // empty' "$STATE_FILE")"; time_plan=-; time_first=-
    disposition=pending
    if [ -f "$PREP_DIR/closure.json" ] && [ "$(jq -r '.verdict // empty' "$PREP_DIR/closure.json" 2>/dev/null)" = APPROVED ]; then disposition=revised/closure-approved
    elif [ -f "$PREP_DIR/review.json" ]; then disposition="broad-$(jq -r '.verdict // "pending"' "$PREP_DIR/review.json" | tr '[:upper:]_' '[:lower:]-')"; fi
    [ -z "$approved" ] || time_plan="$(( $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$approved" +%s 2>/dev/null || date -d "$approved" +%s) - $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$started" +%s 2>/dev/null || date -d "$started" +%s) ))s"
    [ -z "$first" ] || time_first="$(( $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$first" +%s 2>/dev/null || date -d "$first" +%s) - $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$started" +%s 2>/dev/null || date -d "$started" +%s) ))s"
    printf '%s | elapsed %ss | calls %s/%s | repairs %s | timeouts %s\nplan review %s\nstory %s | complete %s/%s\nvalidation %s | cache hits %s | current %s\ntime to plan %s | time to first implementation %s\n' "$phase" "$elapsed" "$calls" "$max" "$repairs" "$timeouts" "$disposition" "$story" "$complete" "$total" "$validation" "$hits" "$current" "$time_plan" "$time_first"
    jq -r 'select(.terminalDiagnostic != null) | "\(.terminalDiagnostic.code): \(.terminalDiagnostic.message)"' "$STATE_FILE"
}

if [ "$MODE" = help ]; then usage; exit 0; fi
require git; require jq; require shasum
git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Error: Looper must run inside a Git repository." >&2; exit 1; }
if [ "$MODE" = watch ]; then watch "$WATCH_ARG"; exit; fi
validate_agent "$IMPLEMENTATION_AGENT" LOOPER_IMPLEMENTATION_AGENT
validate_agent "$REVIEW_AGENT" LOOPER_REVIEW_AGENT
case "$IMPLEMENTATION_AGENT:$REVIEW_AGENT" in *claude*) require claude ;; esac
case "$IMPLEMENTATION_AGENT:$REVIEW_AGENT" in *codex*) require "$CODEX_BIN" ;; esac
case "$IMPLEMENTATION_AGENT:$REVIEW_AGENT" in *opencode*) require opencode ;; esac
[[ "$AGENT_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo "Error: LOOPER_AGENT_TIMEOUT_SECONDS must be positive." >&2; exit 2; }

for file in "$PLAN_SCHEMA" "$REVIEW_SCHEMA" "$CLOSURE_SCHEMA" "$PLANNING_PROMPT" "$PLAN_REVIEW_PROMPT" "$CLOSURE_PROMPT" "$IMPLEMENTER_PROMPT" "$REVIEWER_PROMPT" "$SHARED_PROMPT"; do
    [ -f "$file" ] || { echo "Error: missing Looper asset: $file" >&2; exit 1; }
done

if [ "$MODE" = prepare ] || [ "$MODE" = start ]; then
    prepare
    [ "$MODE" = start ] || exit 0
    MODE=run
fi
if [ "$MODE" = run ]; then
    [[ "$MAX_ITERATIONS" =~ ^[1-9][0-9]*$ ]] || { echo "Error: max_iterations must be positive." >&2; exit 2; }
    verify_current_state
    [ -f "$STORIES_FILE" ] && [ "$(jq -r '.preparation.approvedAt // empty' "$STATE_FILE")" != "" ] || terminal PREPARATION_REQUIRED "Run prepare and obtain an approved stories.json before execution."
    case "$(jq -r '.phase' "$STATE_FILE")" in
      PREPARATION_FAILED|NEEDS_HUMAN)
        terminal "$(jq -r '.terminalDiagnostic.code' "$STATE_FILE")" "$(jq -r '.terminalDiagnostic.message' "$STATE_FILE")" ;;
    esac
    for ((iteration=1; iteration<=MAX_ITERATIONS; iteration++)); do
        if [ "$(jq '[.stories[]|select(.passes==false)]|length' "$STORIES_FILE")" -eq 0 ]; then echo "All stories complete."; exit 0; fi
        execute_story || [ $? -eq 2 ] || exit $?
    done
    if [ "$(jq '[.stories[]|select(.passes==false)]|length' "$STORIES_FILE")" -eq 0 ]; then echo "All stories complete."; exit 0; fi
    echo "Reached $MAX_ITERATIONS iterations with stories still incomplete." >&2
    exit 1
fi
